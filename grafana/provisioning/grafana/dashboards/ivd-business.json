{
  "title": "IVD 业务监控",
  "tags": ["ivd"],
  "timezone": "browser",
  "panels": [
    {
      "title": "请求总数 (QPS)",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(http_requests_total[5m])",
          "legendFormat": "QPS"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "title": "平均响应时间",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_sum[5m]) / rate(http_request_duration_seconds_count[5m])",
          "legendFormat": "响应时间"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "title": "任务队列长度",
      "type": "stat",
      "targets": [
        {
          "expr": "celery_queue_length{queue='celery'}",
          "legendFormat": "队列长度"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 10},
              {"color": "red", "value": 50}
            ]
          }
        }
      }
    },
    {
      "title": "分析任务成功率",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(task_success_total) / (sum(task_success_total) + sum(task_failure_total))",
          "legendFormat": "成功率"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.9},
              {"color": "green", "value": 0.95}
            ]
          }
        }
      }
    },
    {
      "title": "Go 解析服务状态",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job='go-parser'}",
          "legendFormat": "状态"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 8}
    },
    {
      "title": "容器 CPU 使用率",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{name=~'.+'}[5m])) by (name)",
          "legendFormat": "{{name}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
    },
    {
      "title": "容器内存使用",
      "type": "graph",
      "targets": [
        {
          "expr": "sum(container_memory_usage_bytes{name=~'.+'}) by (name)",
          "legendFormat": "{{name}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
    }
  ],
  "schemaVersion": 27,
  "version": 1
}   