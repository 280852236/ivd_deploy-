{
  "title": "IVD智能故障分析平台监控",
  "tags": [
    "ivd",
    "业务监控",
    "中文"
  ],
  "timezone": "browser",
  "panels": [
    {
      "title": "请求总数",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "rate(flask_http_request_total[5m])",
          "refId": "A",
          "legendFormat": "请求/秒",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "displayName": "请求速率"
        }
      }
    },
    {
      "title": "请求延迟（95分位）",
      "type": "gauge",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(flask_http_request_duration_seconds_bucket[5m]))",
          "refId": "A",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "displayName": "响应时间"
        }
      }
    },
    {
      "title": "Celery任务成功率",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "rate(celery_tasks_total{status=\"succeeded\"}[5m]) / rate(celery_tasks_total[5m]) * 100",
          "refId": "A",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "displayName": "成功率"
        }
      }
    },
    {
      "title": "文件分析统计",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(file_analysis_total[5m])",
          "legendFormat": "{{series}}/{{model}} - {{status}}",
          "refId": "A",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayName": "分析速率"
          }
        }
      }
    },
    {
      "title": "CPU使用率",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "refId": "A",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "displayName": "CPU使用率",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      }
    },
    {
      "title": "内存使用率",
      "type": "gauge",
      "gridPos": {
        "x": 4,
        "y": 10,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "refId": "A",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "displayName": "内存使用率",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      }
    },
    {
      "title": "磁盘使用率",
      "type": "gauge",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})) * 100",
          "refId": "A",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "displayName": "磁盘使用率",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      }
    },
    {
      "title": "HTTP请求状态码分布",
      "type": "piechart",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(flask_http_request_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "title": "活跃连接数",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 14,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "active_connections",
          "refId": "A",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "当前连接数"
        }
      }
    }
  ],
  "schemaVersion": 38,
  "version": 0,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "IVD智能故障分析平台业务监控仪表盘",
  "uid": "ivd-business-zh"
}