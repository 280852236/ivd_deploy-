{
  "title": "IVD业务监控",
  "tags": [
    "ivd",
    "business"
  ],
  "timezone": "browser",
  "panels": [
    {
      "title": "请求总数",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "rate(flask_http_request_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "title": "请求延迟",
      "type": "gauge",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(flask_http_request_duration_seconds_bucket[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Celery任务成功率",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "rate(celery_tasks_total{status=\"succeeded\"}[5m]) / rate(celery_tasks_total[5m]) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "title": "文件分析统计",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(file_analysis_total[5m])",
          "legendFormat": "{{series}}/{{model}} - {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "CPU使用率",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "内存使用率",
      "type": "gauge",
      "gridPos": {
        "x": 4,
        "y": 10,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "title": "磁盘使用率",
      "type": "gauge",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})) * 100",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "version": 0,
  "refresh": "10s",
  "uid": "ivd-business"
}