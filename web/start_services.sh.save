#!/bin/bash
# IVD 服务启动脚本（优化版：Redis 就绪检查 + 日志文件输出）

cd /mnt/d/clion/ivd_analyzer
source .venv_wsl/bin/activate

# 创建日志目录
mkdir -p logs

# -------------------- 1. 启动 Redis --------------------
sudo service redis-server start

# -------------------- 2. 等待 Redis 就绪 --------------------
echo "⏳ 等待 Redis 就绪..."
until redis-cli -h 127.0.0.1 ping > /dev/null 2>&1; do
    sleep 1
done
echo "✅ Redis 已就绪"

# -------------------- 3. 启动 Celery Worker（日志输出到文件）------------------
echo "🚀 启动 Celery Worker..."
nohup celery -A celery_app worker --loglevel=info --concurrency=4 > logs/worker.log 2>&1 &

# -------------------- 4. 启动 Gunicorn（日志输出到文件）--------------------
echo "🚀 启动 Gunicorn Web 服务..."
nohup gunicorn -w 4 -b 0.0.0.0:8081 app:app --access-logfile logs/access.log --error-logfile logs/error.log > /dev/null 2>&1 &

# -------------------- 5. 提示信息 --------------------
echo ""
echo "✅ 所有服务已启动！"
echo "📌 查看实时日志："
echo "   Worker 日志：tail -f logs/worker.log"
echo "   访问日志：tail -f logs/access.log"
echo "   错误日志：tail -f logs/error.log"
echo ""
echo "📌 停止服务："
echo "   pkill -f celery && pkill -f gunicorn && sudo service redis-server stop"
