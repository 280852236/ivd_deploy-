MAIN_HTML = '''
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IVD 智能故障分析平台</title>
    <!-- Bootstrap 5 CSS (仅样式) -->
