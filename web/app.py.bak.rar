        }
        .topbar a { 
            color: white; 
            text-decoration: none; 
            font-size: 0.78rem; 
            opacity: 0.9; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            padding: 4px 12px;
            border-radius: 16px;
            background: rgba(255,255,255,0.1);
            display: flex;
            align-items: center;
            gap: 6px;
            cursor: pointer !important;
        }
        .topbar a:hover { 
            opacity: 1;
