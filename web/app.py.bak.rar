        }
        .upload-area:hover i {
            transform: scale(1.2) rotate(10deg);
        }
        .result-box { 
            background: #f8fafc; 
            border-radius: 14px; 
            padding: 20px; 
            max-height: 800px; 
            overflow-y: auto; 
            border: 2px solid #e8ecf1; 
            font-size: 0.95rem; 
        }
        /* 自定义网格 */
        .ivd-grid { display: grid; grid-template-columns: 380px 1fr; gap: 30px; }
        @media (max-width: 900px) { .ivd-grid { grid-template-columns: 1fr; } }
        /* 文件列表样式 */
        .file-item { 
            padding: 10px 14px; 
            margin: 6px 0; 
            background: white; 
            border-radius: 8px; 
            border: 1px solid #e8ecf1; 
            cursor: pointer !important; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); 
            font-size: 0.85rem;
        }
        .file-item:hover { 
            background: #f0f9ff; 
            transform: translateX(5px) translateY(-2px); 
            box-shadow: 0 4px 12px rgba(0,168,204,0.15);
            border-color: #00a8cc;
        }
        .file-item:active {
            transform: translateX(3px) scale(0.98);
        }
        .file-item i {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-block;
        }
        .file-item:hover i {
            transform: scale(1.2) rotate(5deg);
        }
        .file-item.critical { 
            border-left: 4px solid #ef4444; 
            background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
        }
        .analysis-item { 
            padding: 14px; 
            margin: 10px 0; 
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); 
            border-left: 4px solid #f59e0b; 
            border-radius: 10px; 
            line-height: 1.5; 
            font-size: 0.9rem;
            box-shadow: 0 2px 8px rgba(245,158,11,0.1);
        }
        .analysis-item.pdf { background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border-color: #10b981; }
        .analysis-item.smart { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border-color: #22c55e; }
        .tag { 
            background: linear-gradient(135deg, #00a8cc 0%, #0084a8 100%); 
            color: white; 
            padding: 6px 14px; 
            border-radius: 20px; 
            font-size: 0.75rem; 
            display: inline-block; 
            margin: 3px;
            font-weight: 600;
            cursor: pointer !important;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 2px solid transparent;
            position: relative;
            overflow: hidden;
            user-select: none;
        }
        .tag::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.6s, height 0.6s;
        }
        .tag::after {
            content: '👆';
            position: absolute;
            right: -20px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 0.7rem;
            opacity: 0;
            transition: all 0.3s ease;
        }
        .tag i {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-block;
        }
        .tag:hover {
            transform: translateY(-3px) scale(1.05);
            box-shadow: 0 6px 20px rgba(0,168,204,0.4);
        }
        .tag:hover i {
            transform: scale(1.3) rotate(10deg);
        }
        .tag:hover::after {
            right: 4px;
            opacity: 1;
        }
        .tag:active::before {
            width: 200px;
            height: 200px;
        }
        .tag:active {
            transform: translateY(-1px) scale(0.98);
        }
        .tag:active i {
            transform: scale(0.9);
        }
        .tag.active {
            transform: scale(1.1);
            box-shadow: 0 8px 24px rgba(0,168,204,0.5);
            border-color: rgba(255, 255, 255, 0.5);
        }
        .tag.active i {
            animation: icon-bounce 0.6s ease infinite;
        }
        @keyframes icon-bounce {
            0%, 100% { transform: scale(1.2); }
            50% { transform: scale(1.4); }
        }
        .tag-all {
            background: linear-gradient(135deg, #64748b 0%, #475569 100%) !important;
        }
        .tag-all:hover {
            box-shadow: 0 6px 20px rgba(100,116,139,0.4) !important;
        }
        .tag-all.active {
            box-shadow: 0 8px 24px rgba(100,116,139,0.5) !important;
        }
        /* 标签特定颜色 */
        .tag-fault {
            background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%) !important;
            color: #dc2626 !important;
            border: 2px solid #fecaca !important;
        }
        .tag-fault:hover {
            box-shadow: 0 6px 20px rgba(220, 38, 38, 0.4) !important;
        }
        .tag-fault.active {
            box-shadow: 0 8px 24px rgba(220, 38, 38, 0.5) !important;
            background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%) !important;
        }
        .tag-sample {
            background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%) !important;
            color: #1d4ed8 !important;
            border: 2px solid #bfdbfe !important;
        }
        .tag-sample:hover {
            box-shadow: 0 6px 20px rgba(29, 78, 216, 0.4) !important;
        }
        .tag-sample.active {
            box-shadow: 0 8px 24px rgba(29, 78, 216, 0.5) !important;
            background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%) !important;
        }
        .tag-reagent {
            background: linear-gradient(135deg, #faf5ff 0%, #f3e8ff 100%) !important;
            color: #7c3aed !important;
            border: 2px solid #e9d5ff !important;
        }
        .tag-reagent:hover {
            box-shadow: 0 6px 20px rgba(124, 58, 237, 0.4) !important;
        }
        .tag-reagent.active {
            box-shadow: 0 8px 24px rgba(124, 58, 237, 0.5) !important;
            background: linear-gradient(135deg, #f3e8ff 0%, #e9d5ff 100%) !important;
        }
        .tag-receive {
            background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%) !important;
            color: #15803d !important;
            border: 2px solid #bbf7d0 !important;
        }
        .tag-receive:hover {
            box-shadow: 0 6px 20px rgba(21, 128, 61, 0.4) !important;
        }
        .tag-receive.active {
            box-shadow: 0 8px 24px rgba(21, 128, 61, 0.5) !important;
            background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%) !important;
        }
        /* 统计卡片 */
        .stat { 
            background: linear-gradient(135deg, #f8fafc 0%, #f0f4f8 100%); 
            padding: 18px; 
            border-radius: 12px; 
            text-align: center;
            border: 1px solid #e8ecf1;
            transition: all 0.3s ease;
        }
        .stat:hover {
            transform: translateY(-3px);
            box-shadow: 0 4px 12px rgba(0,168,204,0.15);
        }
        .stat .number { 
            font-size: 2rem; 
            font-weight: 700; 
            background: linear-gradient(135deg, #00a8cc 0%, #0084a8 100%); 
            -webkit-background-clip: text; 
            -webkit-text-fill-color: transparent;
        }
        .stat .label { font-size: 0.9rem; color: #64748b; margin-top: 5px; }
        /* 模态框 */
        .modal-overlay { 
            display: none; 
            position: fixed; 
            inset: 0; 
            background: rgba(0,0,0,0.6); 
            justify-content: center; 
            align-items: center; 
            z-index: 9999; 
            padding: 20px;
            backdrop-filter: blur(4px);
        }
        .modal-card { 
            background: white; 
            border-radius: 20px; 
            width: min(100%, 1100px); 
            max-height: 90vh; 
            overflow: hidden; 
            box-shadow: 0 25px 80px rgba(0,0,0,0.25); 
            display: flex; 
            flex-direction: column;
        }
        .modal-header { 
            padding: 20px 24px; 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            border-bottom: 2px solid #f0f4f8;
            background: linear-gradient(135deg, #f8fafc 0%, #f0f4f8 100%);
        }
        .modal-title { font-size: 1.25rem; font-weight: 700; color: #0084a8; }
        .modal-close { 
            border: none; 
            background: #f1f5f9; 
            color: #64748b;
            width: 36px;
            height: 36px;
            border-radius: 50%; 
            cursor: pointer; 
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }
        .modal-close:hover { background: #e2e8f0; color: #ef4444; }
        .modal-body { 
            padding: 24px; 
            overflow-y: auto; 
            white-space: pre-wrap; 
            word-break: break-word; 
            font-family: 'Courier New', monospace; 
            font-size: 0.95rem; 
            line-height: 1.7; 
            color: #334155;
        }
        .btn-load-more {
            background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
            border: 2px solid #10b981;
            color: #047857;
            padding: 12px 24px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-load-more:hover {
            background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(16,185,129,0.2);
        }
        .btn-load-more:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
        }
        footer { 
            text-align: center; 
            padding: 40px; 
            color: #64748b; 
            margin-top: 40px;
            font-size: 0.95rem;
        }
        /* 滚动条美化 */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: linear-gradient(135deg, #00a8cc 0%, #0084a8 100%); border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #0084a8; }
        /* Bootstrap 辅助类覆盖 */
        .bg-primary-gradient { background: linear-gradient(135deg, #00a8cc 0%, #0084a8 100%); }
    </style>
</head>
<body>
<div class="container">
    <div class="header text-center p-4 mb-4 bg-primary-gradient rounded-3 text-white shadow">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
            <div></div>
            <div style="display:flex;align-items:center;gap:15px;">
                <span style="font-size:0.95rem;"><i class="fas fa-user me-1"></i> {{ username }}</span>
                <a href="/admin/logout" style="color:white;text-decoration:none;font-size:0.9rem;padding:5px 12px;background:rgba(255,255,255,0.2);border-radius:8px;"><i class="fas fa-sign-out-alt me-1"></i> 退出</a>
            </div>
        </div>
        <h1><i class="fas fa-flask me-2"></i> IVD 智能故障分析平台</h1>
        <p class="lead">SMART · Venus 系列设备智能诊断系统</p>
    </div>
    <div class="ivd-grid">
        <div class="ivd-card shadow-sm p-4">
            <h2><i class="fas fa-upload me-2"></i> 上传文件</h2>
            <div style="display:flex;gap:10px;margin-bottom:10px;">
                <button class="ivd-btn series-btn active" data-series="SMART" style="flex:1;background:#1e6f9f;">SMART</button>
                <button class="ivd-btn series-btn" data-series="Venus" style="flex:1;background:#6c757d;">Venus</button>
            </div>
            <select id="modelSelect" class="form-select"><option>请先选择系列</option></select>
            <div class="upload-area" id="uploadArea">
                <div style="font-size:1.2rem;margin-bottom:5px;"><i class="fas fa-cloud-upload-alt me-2"></i>点击或拖拽文件</div>
                <div style="font-size:0.9rem;color:#999;">支持 .txt .log .zip | 可多选 | 最大 50MB</div>
                <input type="file" id="fileInput" accept=".txt,.log,.zip" multiple style="display:none">
                <div id="fileName" style="margin-top:10px;font-weight:500;color:#1e6f9f;"></div>
            </div>
            <div style="margin-top:12px;">
                <div style="font-size:0.9rem;color:#0891b2;margin-bottom:6px;display:flex;align-items:center;gap:6px;"><i class="fas fa-snowflake"></i> 试剂制冷排查</div>
                <div class="upload-area" id="coolingUploadArea" style="border-color:#0891b2;background:linear-gradient(135deg, #f0fdfa 0%, #e0f2fe 100%);padding:18px;">
                    <div style="font-size:1rem;margin-bottom:4px;"><i class="fas fa-cloud-upload-alt me-2" style="color:#0891b2;"></i>点击或拖拽上传</div>
                    <div style="font-size:0.8rem;color:#64748b;">仅支持 .txt .log | 单文件 | 最大 50MB</div>
                    <input type="file" id="coolingFileInput" accept=".txt,.log" style="display:none">
                    <div id="coolingFileName" style="margin-top:8px;font-weight:500;color:#0891b2;font-size:0.85rem;"></div>
                </div>
            </div>
            <button class="ivd-btn" id="analyzeBtn"><i class="fas fa-search me-1"></i> 开始分析</button>
            {% if is_admin %}
            <a href="/admin/rules" class="admin-link"><i class="fas fa-cog me-1"></i> 管理知识库 →</a>
            {% endif %}
        </div>
        <div class="ivd-card shadow-sm p-4">
            <h2><i class="fas fa-clipboard-list me-2"></i> 诊断报告</h2>
            <div class="result-box" id="resultArea">
                <div class="empty-state text-center py-5 text-secondary">
                    <i class="fas fa-microscope" style="font-size:4rem;opacity:0.4;"></i>
                    <div class="mt-3">请上传文件并开始分析</div>
                    <div style="font-size:0.9rem;color:#999;margin-top:5px;">系统将自动识别故障并提供解决方案</div>
                </div>
            </div>
            <div style="margin-top:15px;">
                <a href="/bugs?series=SMART" class="admin-link" style="background:linear-gradient(135deg,#f0fdf4 0%,#dcfce7 100%);border-color:#22c55e;color:#15803d;"><i class="fas fa-bug me-1"></i> 上位机Bug库 →</a>
                <a href="/lis-issues" class="admin-link" style="background:linear-gradient(135deg,#fef3c7 0%,#fde68a 100%);border-color:#f59e0b;color:#92400e;"><i class="fas fa-exchange-alt me-1"></i> LIS问题排查工具 →</a>
                <a href="/hardware-failures" class="admin-link" style="background:linear-gradient(135deg,#fee2e2 0%,#fecaca 100%);border-color:#ef4444;color:#991b1b;"><i class="fas fa-microchip me-1"></i> 硬件故障案例 →</a>
                <a href="/board-compatibility" class="admin-link" style="background:linear-gradient(135deg,#e0e7ff 0%,#c7d2fe 100%);border-color:#6366f1;color:#4338ca;"><i class="fas fa-puzzle-piece me-1"></i> 电路板兼容库 →</a>
            </div>
        </div>
    </div>
    <footer><i class="far fa-copyright me-1"></i> 2026 IVD 智能故障分析平台 v3.0</footer>
</div>

<script>
let currentSeries = 'SMART';
let selectedFiles = [];

// 诊断报告分页状态
let reportGroups = {
    fault: { data: [], limit: 50, total: 0, displayed: 0 },
    sample: { data: [], limit: 50, total: 0, displayed: 0 },
    reagent: { data: [], limit: 50, total: 0, displayed: 0 }
};

// 文件列表数据（用于查看全文）
let fileContentsMap = {};
let fileMetadataList = [];

// 系列切换
async function loadModelsForSeries(series, defaultModel = '') {
    currentSeries = series;
    document.querySelectorAll('.series-btn').forEach(b => {
        b.style.background = b.dataset.series === series ? '#1e6f9f' : '#6c757d';
    });
    const resp = await fetch(`/api/models?series=${currentSeries}`);
    const models = await resp.json();
    let opts = '<option value="">请选择型号</option>';
    models.forEach(m => opts += `<option value="${m.name}">${m.name}</option>`);
    const modelSelect = document.getElementById('modelSelect');
    modelSelect.innerHTML = opts;
    if (defaultModel && models.some(m => m.name === defaultModel)) {
        modelSelect.value = defaultModel;
    }
}

document.querySelectorAll('.series-btn').forEach(btn => {
    btn.onclick = function() {
        loadModelsForSeries(this.dataset.series);
    };
});

window.addEventListener('DOMContentLoaded', () => {
    loadModelsForSeries('SMART', 'SMART6500');
});

// 文件上传
const uploadArea = document.getElementById('uploadArea');
const fileInput = document.getElementById('fileInput');

uploadArea.onclick = () => fileInput.click();
fileInput.onchange = e => {
    if (e.target.files.length) {
        selectedFiles = Array.from(e.target.files);
        // 清除冷却上传框的文件，避免混淆
        coolingFile = null;
        document.getElementById('coolingFileName').innerHTML = '';
        const totalSize = selectedFiles.reduce((sum, f) => sum + f.size, 0);
        if (selectedFiles.length === 1) {
            document.getElementById('fileName').innerHTML = `<i class="fas fa-check-circle text-success me-1"></i> ${selectedFiles[0].name} (${(selectedFiles[0].size/1024).toFixed(0)} KB)`;
        } else {
            document.getElementById('fileName').innerHTML = `<i class="fas fa-check-circle text-success me-1"></i> 已选择 ${selectedFiles.length} 个文件 (${(totalSize/1024).toFixed(0)} KB)`;
        }
    }
};

uploadArea.ondragover = e => e.preventDefault();
uploadArea.ondrop = e => {
    e.preventDefault();
    if (e.dataTransfer.files.length) {
        selectedFiles = Array.from(e.dataTransfer.files);
        // 清除冷却上传框的文件，避免混淆
        coolingFile = null;
        document.getElementById('coolingFileName').innerHTML = '';
        const totalSize = selectedFiles.reduce((sum, f) => sum + f.size, 0);
        if (selectedFiles.length === 1) {
            document.getElementById('fileName').innerHTML = `<i class="fas fa-check-circle text-success me-1"></i> ${selectedFiles[0].name} (${(selectedFiles[0].size/1024).toFixed(0)} KB)`;
        } else {
            document.getElementById('fileName').innerHTML = `<i class="fas fa-check-circle text-success me-1"></i> 已选择 ${selectedFiles.length} 个文件 (${(totalSize/1024).toFixed(0)} KB)`;
        }
    }
};

// 分析按钮
document.getElementById('analyzeBtn').onclick = async function() {
    const isCoolingMode = coolingFile !== null;
    
    if (isCoolingMode) {
        this.disabled = true;
        this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> 排查中...';
        document.getElementById('resultArea').innerHTML = '<div class="text-center py-5"><i class="fas fa-snowflake" style="font-size:3rem;color:#0891b2;"></i><div class="mt-3">正在排查制冷异常...</div></div>';
        const fd = new FormData();
        fd.append('file', coolingFile);
        fd.append('series', 'SMART');
        fd.append('model', 'SMART6500');
        fd.append('analysis_type', 'reagent_cooling');
        try {
            const resp = await fetchWithTimeout('/api/analyze', { method: 'POST', body: fd }, 300000);
            if (!resp.ok) {
                const text = await resp.text();
                let errMsg = '服务器错误';
                try { const ed = JSON.parse(text); if (ed.error) errMsg = ed.error; } catch(e) { errMsg = text.slice(0, 200); }
                document.getElementById('resultArea').innerHTML = '<div class="alert alert-danger">' + errMsg.replace(/\\n/g, '<br>') + '</div>';
                return;
            }
            const data = await resp.json();
            if (data.error) { document.getElementById('resultArea').innerHTML = '<div class="alert alert-danger">' + data.error.replace(/\\n/g, '<br>') + '</div>'; return; }
            if (data.status === 'accepted' && data.analysis_id) {
                document.getElementById('resultArea').innerHTML = '<div class="text-center py-5"><i class="fas fa-snowflake fa-spin" style="font-size:3rem;color:#0891b2;"></i><div class="mt-3">正在排查制冷异常...</div></div>';
                pollTaskStatus(data.analysis_id, this, true);
                return;
            }
            if (data.redirect_url) { window.location.href = data.redirect_url; return; }
        } catch (err) {
            document.getElementById('resultArea').innerHTML = '<div class="alert alert-danger">❌ 排查失败: ' + err.message + '</div>';
        } finally {
            if (!isCoolingMode || !document.getElementById('analyzeBtn').dataset.polling) {
                this.disabled = false;
                this.innerHTML = '<i class="fas fa-search me-1"></i> 开始分析';
            }
        }
        return;
    }
    
    const model = document.getElementById('modelSelect').value;
    if (!model) {
        document.getElementById('resultArea').innerHTML = '<div class="alert alert-danger">⚠️ 请选择设备型号</div>';
        return;
    }
    if (!selectedFiles || selectedFiles.length === 0) {
        document.getElementById('resultArea').innerHTML = '<div class="alert alert-danger">⚠️ 请选择文件</div>';
        return;
    }
    this.disabled = true;
    this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> 分析中...';
    document.getElementById('resultArea').innerHTML = '<div class="text-center py-5"><i class="fas fa-hourglass-half" style="font-size:3rem;color:#0084a8;"></i><div class="mt-3">正在智能分析...</div></div>';

    const fd = new FormData();
    if (selectedFiles.length === 1) {
        fd.append('file', selectedFiles[0]);
    } else {
        selectedFiles.forEach((file) => { fd.append('files', file); });
    }
    fd.append('series', currentSeries);
    fd.append('model', model);

    try {
        const resp = await fetchWithTimeout('/api/analyze', { method: 'POST', body: fd }, 300000);
        if (!resp.ok) {
            const text = await resp.text();
            let errMsg = '服务器错误';
            try { const ed = JSON.parse(text); if (ed.error) errMsg = ed.error; } catch(e) { errMsg = text.slice(0, 300); }
            document.getElementById('resultArea').innerHTML = '<div class="alert alert-danger">' + errMsg.replace(/\\n/g, '<br>') + '</div>';
            return;
        }
        const data = await resp.json();
        if (data.error) {
            document.getElementById('resultArea').innerHTML = '<div class="alert alert-danger">' + data.error.replace(/\\n/g, '<br>') + '</div>';
            return;
        }
        if (data.status === 'accepted' && data.analysis_id) {
            document.getElementById('resultArea').innerHTML = '<div class="text-center py-5"><i class="fas fa-cog fa-spin" style="font-size:3rem;color:#2563eb;"></i><div class="mt-3">任务已提交，正在智能分析...</div></div>';
            pollTaskStatus(data.analysis_id, this, false);
            return;
        }
        if (data.redirect_url) {
            window.location.href = data.redirect_url;
            return;
        }
    } catch (err) {
        let message;
        if (err.name === 'TimeoutError') {
            message = '⏰ 分析请求超时，请重试';
        } else if (err.message && err.message.includes('Failed to fetch')) {
            message = '🔌 无法连接到服务器，请确认服务已启动';
        } else {
            message = `请求失败: ${err.message}`;
        }
        document.getElementById('resultArea').innerHTML = `<div class="alert alert-danger">❌ ${message}</div>`;
    } finally {
        if (!document.getElementById('analyzeBtn').dataset.polling) {
            this.disabled = false;
            this.innerHTML = '<i class="fas fa-search me-1"></i> 开始分析';
        }
    }
};

function pollTaskStatus(analysisId, btn, isCooling) {
    btn.dataset.polling = 'true';
    let pollCount = 0;
    const maxPolls = 600;
    const interval = 1000;
    function poll() {
        pollCount++;
        if (pollCount > maxPolls) {
            delete btn.dataset.polling;
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-search me-1"></i> 开始分析';
            document.getElementById('resultArea').innerHTML = '<div class="alert alert-warning">⏰ 分析超时，请重试</div>';
            return;
        }
        fetch(`/api/task_status/${analysisId}`)
            .then(r => r.json())
            .then(d => {
                if (d.status === 'completed' && d.redirect_url) {
                    delete btn.dataset.polling;
                    window.location.href = d.redirect_url;
                } else if (d.status === 'failed') {
                    delete btn.dataset.polling;
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-search me-1"></i> 开始分析';
                    document.getElementById('resultArea').innerHTML = `<div class="alert alert-danger">❌ 分析失败: ${d.error || '未知错误'}</div>`;
                } else {
                    const icon = isCooling ? 'fa-snowflake' : 'fa-cog';
                    const color = isCooling ? '#0891b2' : '#2563eb';
                    const text = isCooling ? '正在排查制冷异常' : '正在智能分析';
                    document.getElementById('resultArea').innerHTML = `<div class="text-center py-5"><i class="fas ${icon} fa-spin" style="font-size:3rem;color:${color};"></i><div class="mt-3">${text}... (已等待 ${pollCount} 秒)</div></div>`;
                    setTimeout(poll, interval);
                }
            })
            .catch(() => { setTimeout(poll, 2000); });
    }
    setTimeout(poll, 1000);
}

// ========== 试剂制冷排查 ==========
const coolingUploadArea = document.getElementById('coolingUploadArea');
const coolingFileInput = document.getElementById('coolingFileInput');
let coolingFile = null;

coolingUploadArea.onclick = () => coolingFileInput.click();
coolingUploadArea.ondragover = e => { e.preventDefault(); coolingUploadArea.style.borderColor = '#0e7490'; coolingUploadArea.style.background = 'linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%)'; };
coolingUploadArea.ondragleave = e => { e.preventDefault(); coolingUploadArea.style.borderColor = '#0891b2'; coolingUploadArea.style.background = ''; };
coolingUploadArea.ondrop = e => { e.preventDefault(); coolingUploadArea.style.borderColor = '#0891b2'; coolingUploadArea.style.background = ''; if (e.dataTransfer.files.length > 0) handleCoolingFile(e.dataTransfer.files[0]); };

coolingFileInput.onchange = e => { if (e.target.files.length > 0) handleCoolingFile(e.target.files[0]); };

function handleCoolingFile(file) {
    const name = file.name.toLowerCase();
    if (!name.endsWith('.txt') && !name.endsWith('.log')) {
        alert('仅支持 .txt 和 .log 文件！');
        coolingFileInput.value = '';
        return;
    }
    if (file.size > 50 * 1024 * 1024) {
        alert('文件大小不能超过50MB！');
        coolingFileInput.value = '';
        return;
    }
    coolingFile = file;
    // 清除上方上传框的文件，避免混淆
    selectedFiles = [];
    document.getElementById('fileName').innerHTML = '';
    const sizeMB = (file.size / 1024 / 1024).toFixed(2);
    document.getElementById('coolingFileName').innerHTML = '<i class="fas fa-check-circle" style="color:#10b981;margin-right:4px;"></i>' + file.name + ' (' + sizeMB + ' MB)';
}

// ========== 渲染结果 ==========
function renderResult(data) {
    // 重置分页
    reportGroups = {
        fault: { data: [], limit: 50, total: 0, displayed: 0 },
        sample: { data: [], limit: 50, total: 0, displayed: 0 },
        reagent: { data: [], limit: 50, total: 0, displayed: 0 }
    };

    const faultAlerts = data.analysis ? data.analysis.filter(item => item.type === 'motor_status_match') : [];
    const hasFaultDoc = faultAlerts.length > 0;
    const sampleEmpty = hasFaultDoc ? [] : (data.analysis ? data.analysis.filter(item => 
        item.type === 'keyword_match' && 
        item.keywords && item.keywords.some(kw => ['样本空吸', '样本不足'].includes(kw))
    ) : []);
    const reagentEmpty = hasFaultDoc ? [] : (data.analysis ? data.analysis.filter(item => 
        item.type === 'keyword_match' && 
        item.keywords && item.keywords.some(kw => ['试剂空吸', '试剂不足'].includes(kw))
    ) : []);

    reportGroups.fault.data = faultAlerts;
    reportGroups.fault.total = faultAlerts.length;
    reportGroups.fault.timestamp = data.analyzed_at ? data.analyzed_at : '';
    reportGroups.sample.data = sampleEmpty;
    reportGroups.sample.total = sampleEmpty.length;
    reportGroups.reagent.data = reagentEmpty;
    reportGroups.reagent.total = reagentEmpty.length;

    const displayedCount = faultAlerts.length + sampleEmpty.length + reagentEmpty.length;
    const showSampleReagentGroups = !hasFaultDoc;

    // 统计卡片
    let html = `
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-3"><div class="stat"><div class="number">${displayedCount}</div><div class="label">总命令/故障数</div></div></div>
            <div class="col-6 col-md-3"><div class="stat"><div class="number">${faultAlerts.length}</div><div class="label">故障表</div></div></div>
            <div class="col-6 col-md-3"><div class="stat"><div class="number">${showSampleReagentGroups ? sampleEmpty.length : 0}</div><div class="label">样本发送表</div></div></div>
            <div class="col-6 col-md-3"><div class="stat"><div class="number">${showSampleReagentGroups ? reagentEmpty.length : 0}</div><div class="label">试剂发送表</div></div></div>
        </div>
    `;

    if (hasFaultDoc) {
        html += `<div class="alert alert-warning"><i class="fas fa-exclamation-triangle me-1"></i> 检测到故障文档，样本/试剂匹配结果已隐藏。</div>`;
    }

    // 文件列表
    if (fileMetadataList.length > 0) {
        html += `<div class="card shadow-sm p-3 mb-3"><div class="fw-bold fs-6 text-primary mb-2"><i class="fas fa-folder-open me-1"></i> 分析文件列表 (${fileMetadataList.length} 个)</div><div style="max-height:250px;overflow-y:auto;">`;
        fileMetadataList.forEach((f, idx) => {
            const icon = f.is_critical ? '<i class="fas fa-circle text-danger"></i>' : '<i class="fas fa-file-alt"></i>';
            html += `<div class="file-item ${f.is_critical ? 'critical' : ''}" data-file-index="${idx}" style="cursor:pointer;">
                ${icon} ${escapeHtml(f.name)} <span class="text-secondary" style="font-size:0.85rem;">(${f.size} 字符)</span>
                ${f.is_critical ? '<span class="badge bg-danger ms-2">关键文件</span>' : ''}
            </div>`;
        });
        html += `</div></div>`;
    }

    // 三个分组
    html += renderGroup('fault', '🚨 故障表', '故障命令记录');
    if (!hasFaultDoc) {
        html += renderGroup('sample', '🧪 样本发送表', '样本发送命令');
        html += renderGroup('reagent', '🧫 试剂发送表', '试剂发送命令');
    }

    document.getElementById('resultArea').innerHTML = html;

    // 绑定文件点击
    document.querySelectorAll('.file-item[data-file-index]').forEach(el => {
        el.addEventListener('click', () => openFilePreviewByIndex(el.dataset.fileIndex));
    });

    renderGroupItems('fault');
    renderGroupItems('sample');
    renderGroupItems('reagent');
}

function escapeHtml(text) {
    if (!text) return '';
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
}

function groupFaultItemsByDate(items) {
    const groups = {};
    items.forEach(item => {
        const date = item.event_date || '未识别日期';
        if (!groups[date]) {
            groups[date] = [];
        }
        groups[date].push(item);
    });
    return Object.keys(groups).sort().map(date => ({ date, items: groups[date] }));
}

function openFilePreviewByIndex(index) {
    const idx = parseInt(index, 10);
    const fileMeta = fileMetadataList[idx];
    const filename = fileMeta ? fileMeta.name : '';
    const content = filename ? (fileContentsMap[filename] || '') : '';
    const previewModal = document.getElementById('filePreviewModal');
    const previewContent = document.getElementById('filePreviewContent');
    const previewTitle = document.getElementById('filePreviewTitle');
    if (!previewModal || !previewContent || !previewTitle) return;
    previewTitle.textContent = filename || '文件预览';
    previewContent.textContent = content || '⚠️ 文件内容为空或未加载。';
    previewModal.style.display = 'flex';
}

function closeFilePreview() {
    const previewModal = document.getElementById('filePreviewModal');
    if (previewModal) {
        previewModal.style.display = 'none';
    }
}

function fetchWithTimeout(url, options = {}, timeout = 300000) {
    const controller = new AbortController();
    const signal = controller.signal;
    const fetchOptions = { ...options, signal };
    const timeoutId = setTimeout(() => {
        controller.abort();
    }, timeout);
    return fetch(url, fetchOptions)
        .finally(() => clearTimeout(timeoutId))
        .catch(err => {
            if (err.name === 'AbortError') {
                const timeoutErr = new Error('请求超时');
                timeoutErr.name = 'TimeoutError';
                throw timeoutErr;
            }
            throw err;
        });
}

function renderGroup(groupKey, title, emptyMsg) {
    const total = reportGroups[groupKey].total;
    const timestamp = groupKey === 'fault' ? reportGroups[groupKey].timestamp : '';
    return `
        <div class="card shadow-sm p-3 mt-3">
            <div class="fw-bold fs-6 text-primary">${title} <span class="text-secondary fw-normal fs-6">(共 ${total} 条)</span></div>
            ${timestamp ? `<div class="small text-muted mb-2"><i class="far fa-clock me-1"></i> 故障分析时间: ${escapeHtml(timestamp)}</div>` : ''}
            <div id="group-${groupKey}-container">
                ${total === 0 ? `<div class="text-secondary">暂无 ${emptyMsg}</div>` : ''}
            </div>
            <div id="group-${groupKey}-loadmore" class="text-center mt-2"></div>
        </div>
    `;
}

function renderGroupItems(groupKey) {
    const group = reportGroups[groupKey];
    const container = document.getElementById(`group-${groupKey}-container`);
    const loadMoreDiv = document.getElementById(`group-${groupKey}-loadmore`);
    if (!container) return;
    const total = group.total;
    if (total === 0) {
        container.innerHTML = `<div class="text-secondary">暂无记录</div>`;
        if (loadMoreDiv) loadMoreDiv.innerHTML = '';
        return;
    }
    let displayed = group.displayed || 0;
    if (displayed === 0) {
        displayed = Math.min(50, total);
        group.displayed = displayed;
    }
    const items = group.data.slice(0, displayed);
    let html = '';
    if (groupKey === 'fault') {
        const dateGroups = groupFaultItemsByDate(items);
        dateGroups.forEach(groupItem => {
            const headerTime = groupItem.items[0] && groupItem.items[0].event_time ? groupItem.items[0].event_time : '';
            html += `
                <div class="border rounded p-3 mb-3 bg-light">
                    <div class="d-flex justify-content-between align-items-start flex-wrap mb-2">
                        <div><div class="fw-bold text-warning">故障日期：${escapeHtml(groupItem.date)}</div>
                        ${headerTime ? `<div class="small text-muted">首次记录时间：${escapeHtml(headerTime)}</div>` : ''}</div>
                        <span class="badge bg-secondary">共 ${groupItem.items.length} 条故障</span>
                    </div>
            `;
            groupItem.items.forEach(item => {
                const original = item.original_text || ''; 
                const diagnosisText = item.db_match_text || item.db_command || item.advice || '';
                const diagnosis = diagnosisText ? `<div class="flex-shrink-0 ms-3" style="min-width:220px;max-width:42%;"><strong>诊断建议：</strong><span class="text-success">${escapeHtml(diagnosisText)}</span></div>` : '';
                html += `
                    <div class="d-flex align-items-start justify-content-between flex-wrap p-3 mb-2 bg-white rounded border-start border-4 border-warning">
                        <div class="flex-grow-1" style="min-width:220px;font-size:0.88rem;">${escapeHtml(original)}</div>
                        ${diagnosis}
                    </div>
                `;
            });
            html += `</div>`;
        });
    } else {
        items.forEach(item => {
            const original = item.original_text || '';
            html += `
                <div class="p-3 mb-2 bg-white rounded border-start border-4 border-info">
                    <div style="white-space:pre-wrap;word-break:break-word;font-size:0.88rem;">${escapeHtml(original)}</div>
                </div>
            `;
        });
    }
    container.innerHTML = html;
    if (loadMoreDiv) {
        if (displayed < total) {
            const remaining = total - displayed;
            loadMoreDiv.innerHTML = `
                <button class="ivd-btn" onclick="loadMoreGroup('${groupKey}')" style="width:auto;padding:8px 20px;display:inline-block;margin:0 auto;font-size:0.9rem;">
                    <i class="fas fa-arrow-down me-1"></i> 加载更多 ${Math.min(50, remaining)} 条 (已显示 ${displayed}/${total})
                </button>
            `;
        } else {
            loadMoreDiv.innerHTML = `<div class="text-secondary"><i class="fas fa-check-circle text-success me-1"></i> 已显示全部 ${total} 条</div>`;
        }
    }
}

function loadMoreGroup(groupKey) {
    const group = reportGroups[groupKey];
    let newDisplayed = (group.displayed || 0) + 50;
    if (newDisplayed > group.total) newDisplayed = group.total;
    group.displayed = newDisplayed;
    renderGroupItems(groupKey);
}
</script>

<div id="filePreviewModal" class="modal-overlay" onclick="if(event.target === this) closeFilePreview();">
    <div class="modal-card">
        <div class="modal-header">
            <div id="filePreviewTitle" class="modal-title"><i class="fas fa-file-alt me-2"></i>文件预览</div>
            <button type="button" class="modal-close" onclick="closeFilePreview()"><i class="fas fa-times"></i></button>
        </div>
        <div id="filePreviewContent" class="modal-body"></div>
    </div>
</div>
</body>
</html>
'''
# ========== MAIN_HTML 结束 ==========

# ========== 模板: BUGS_HTML (上位机Bug库) ==========
BUGS_HTML = '''
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>上位机Bug库</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%); padding: 20px; min-height: 100vh; }
        .container { max-width: 1200px; margin: 0 auto; }
        .ivd-card { background: white; border-radius: 16px; padding: 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border: 1px solid #e8ecf1; margin-bottom: 24px; }
        .header-bar { background: linear-gradient(135deg, #00a8cc 0%, #0084a8 100%); border-radius: 16px; padding: 24px 28px; margin-bottom: 24px; color: white; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 20px rgba(0,168,204,0.3); }
        .header-bar h1 { font-size: 1.5rem; font-weight: 700; margin: 0; }
        .header-bar .back-link { color: white; text-decoration: none; font-size: 0.95rem; opacity: 0.9; transition: opacity 0.2s; }
        .header-bar .back-link:hover { opacity: 1; }
        .btn-primary-custom { background: linear-gradient(135deg, #00a8cc 0%, #0084a8 100%); color: white; border: none; border-radius: 10px; padding: 10px 20px; font-weight: 600; cursor: pointer; transition: all 0.3s; }
        .btn-primary-custom:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,168,204,0.4); color: white; }
        .btn-danger-custom { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; border: none; border-radius: 10px; padding: 8px 16px; font-weight: 600; cursor: pointer; transition: all 0.3s; font-size: 0.85rem; }
        .btn-danger-custom:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(239,68,68,0.4); }
        .btn-sm-custom { padding: 6px 14px; font-size: 0.82rem; border-radius: 8px; border: none; cursor: pointer; font-weight: 600; transition: all 0.2s; }
        .btn-edit { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; }
        .btn-edit:hover { box-shadow: 0 4px 12px rgba(245,158,11,0.4); }
        .bug-item { background: #f8fafc; border-radius: 14px; padding: 20px; margin-bottom: 16px; border: 1px solid #e8ecf1; transition: all 0.2s; }
        .bug-item:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); border-color: #00a8cc; }
        .bug-title { font-size: 1.1rem; font-weight: 700; color: #1e293b; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
        .bug-field { margin-bottom: 8px; line-height: 1.6; }
        .bug-field-label { font-weight: 600; color: #475569; min-width: 100px; display: inline-block; }
        .bug-field-value { color: #334155; }
        .bug-meta { display: flex; gap: 16px; margin-top: 12px; padding-top: 12px; border-top: 1px solid #e8ecf1; font-size: 0.85rem; color: #94a3b8; flex-wrap: wrap; align-items: center; }
        .bug-image-thumb { max-width: 120px; max-height: 80px; border-radius: 8px; cursor: pointer; transition: transform 0.2s; border: 2px solid #e8ecf1; }
        .bug-image-thumb:hover { transform: scale(1.1); border-color: #00a8cc; }
        .img-delete-wrap { position: relative; display: inline-block; }
        .img-delete-wrap .img-del-btn { position: absolute; top: -6px; right: -6px; width: 22px; height: 22px; background: #ef4444; color: #fff; border: 2px solid #fff; border-radius: 50%; font-size: 0.7rem; cursor: pointer; opacity: 0; visibility: hidden; display: flex; align-items: center; justify-content: center; z-index: 5; box-shadow: 0 2px 6px rgba(0,0,0,0.3); transition: all 0.15s; }
        .img-delete-wrap:hover .img-del-btn { opacity: 1; visibility: visible; }
        .img-delete-wrap .img-del-btn:hover { transform: scale(1.2); background: #dc2626; }
        .img-delete-wrap .bug-image-thumb:hover { transform: none; border-color: #ef4444; }
        #pasteZone.drag-over { border-color: #00a8cc; background: #e0f2fe; }
        .filter-bar { display: flex; gap: 12px; align-items: center; margin-bottom: 20px; flex-wrap: wrap; }
        .stat-badge { display: inline-flex; align-items: center; gap: 6px; background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); padding: 8px 16px; border-radius: 20px; font-weight: 600; color: #0369a1; font-size: 0.9rem; }
        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); justify-content: center; align-items: center; z-index: 9999; padding: 20px; backdrop-filter: blur(4px); }
        .modal-card { background: white; border-radius: 20px; width: min(100%, 700px); max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 80px rgba(0,0,0,0.25); }
        .modal-header { padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #f0f4f8; background: linear-gradient(135deg, #f8fafc 0%, #f0f4f8 100%); }
        .modal-title { font-size: 1.2rem; font-weight: 700; color: #0084a8; }
        .modal-close { border: none; background: #f1f5f9; color: #64748b; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; font-size: 1.3rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
        .modal-close:hover { background: #e2e8f0; color: #ef4444; }
        .modal-body { padding: 24px; }
        .form-label-custom { font-weight: 600; color: #475569; margin-bottom: 6px; }
        .form-control-custom { border-radius: 10px; border: 2px solid #e8ecf1; padding: 10px 14px; transition: border-color 0.2s; }
        .form-control-custom:focus { border-color: #00a8cc; box-shadow: 0 0 0 3px rgba(0,168,204,0.1); }
        .empty-state { text-align: center; padding: 60px 20px; color: #94a3b8; }
        .empty-state i { font-size: 4rem; opacity: 0.4; }
        .image-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 10000; justify-content: center; align-items: center; cursor: pointer; }
        .image-overlay img { max-width: 90vw; max-height: 90vh; border-radius: 12px; box-shadow: 0 0 40px rgba(0,0,0,0.5); }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: linear-gradient(135deg, #00a8cc 0%, #0084a8 100%); border-radius: 10px; }
    </style>
</head>
<body>
<div class="container">
    <div class="header-bar">
        <div>
            <h1><i class="fas fa-bug me-2"></i> 上位机Bug库</h1>
            <div style="font-size:0.9rem;opacity:0.85;margin-top:4px;">软件Bug记录与追踪</div>
        </div>
        <a href="/" class="back-link"><i class="fas fa-arrow-left me-1"></i> 返回主页</a>
    </div>
    <div class="ivd-card">
        <div class="filter-bar">
            <select id="seriesFilter" class="form-select form-control-custom" style="max-width:160px;">
                <option value="">选择系列</option>
                <option value="SMART">SMART</option>
                <option value="VENUS">VENUS</option>
            </select>
            <select id="modelFilter" class="form-select form-control-custom" style="max-width:200px;">
                <option value="">选择型号</option>
            </select>
            <select id="versionFilter" class="form-select form-control-custom" style="max-width:180px;">
                <option value="">请选择版本</option>
            </select>
            <button class="btn-primary-custom" id="queryBtn" onclick="queryAll()" disabled><i class="fas fa-search me-1"></i> 查询全部</button>
            <div class="stat-badge" id="bugCount"><i class="fas fa-bug"></i> <span>0</span> 条记录</div>
            <div style="flex:1;"></div>
            <button class="btn-primary-custom" id="addBtn" onclick="openAddModal()" disabled><i class="fas fa-plus me-1"></i> 添加Bug</button>
        </div>
        <div style="display:flex;gap:10px;margin-bottom:16px;">
            <input type="text" id="searchInput" class="form-control form-control-custom" placeholder="搜索Bug（标题、原因、方案、版本号）..." style="flex:1;">
            <button class="btn-primary-custom" onclick="doSearch(1)"><i class="fas fa-search me-1"></i> 搜索</button>
        </div>
        <div id="bugList">
            <div class="empty-state"><i class="fas fa-hand-pointer"></i><div class="mt-3">请先选择系列和型号</div></div>
        </div>
        <div id="pagination" style="margin-top:16px;display:flex;justify-content:center;gap:8px;flex-wrap:wrap;"></div>
    </div>
</div>
<div class="modal-overlay" id="bugModal">
    <div class="modal-card">
        <div class="modal-header">
            <div class="modal-title" id="modalTitle">添加Bug</div>
            <button class="modal-close" onclick="closeModal()">&times;</button>
        </div>
        <div class="modal-body">
            <form id="bugForm" onsubmit="return false;">
                <input type="hidden" id="editId" value="">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label-custom">设备型号 *</label>
                        <input type="text" id="bugModelDisplay" class="form-control form-control-custom" readonly style="background:#f1f5f9;color:#475569;font-weight:600;">
                        <input type="hidden" id="bugModel" value="">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-custom">上位机版本号 *</label>
                        <input type="text" id="bugVersion" class="form-control form-control-custom" placeholder="例如: V3.2.1" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label-custom">Bug标题 *</label>
                        <input type="text" id="bugTitle" class="form-control form-control-custom" placeholder="简要描述Bug现象" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label-custom">造成原因</label>
                        <textarea id="bugCause" class="form-control form-control-custom" rows="2" placeholder="分析Bug产生的根本原因"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label-custom">临时规避措施</label>
                        <textarea id="bugWorkaround" class="form-control form-control-custom" rows="2" placeholder="用户可采取的临时解决方案"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label-custom">解决方案</label>
                        <textarea id="bugSolution" class="form-control form-control-custom" rows="2" placeholder="正式修复方案（通常为新版本号）"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label-custom">附加截图（可选，支持多张）</label>
                        <div id="pasteZone" style="border:2px dashed #cbd5e1;border-radius:12px;padding:20px;text-align:center;cursor:pointer;transition:all 0.2s;background:#f8fafc;margin-bottom:8px;" onclick="document.getElementById('bugImage').click()">
                            <i class="fas fa-images" style="font-size:2rem;color:#94a3b8;"></i>
                            <div style="margin-top:8px;color:#64748b;font-weight:600;">点击选择图片 或 Ctrl+V 粘贴截图</div>
                            <div style="font-size:0.8rem;color:#94a3b8;margin-top:4px;">支持多选、多次粘贴，JPG/PNG/GIF/WebP，大图自动压缩</div>
                        </div>
                        <input type="file" id="bugImage" class="form-control form-control-custom" accept="image/jpeg,image/png,image/gif,image/webp" multiple style="display:none;">
                        <div id="imagePreviewArea" style="margin-top:8px;display:flex;flex-wrap:wrap;gap:10px;"></div>
                    </div>
                    <div class="col-12" style="text-align:right;margin-top:8px;">
                        <button type="button" class="btn btn-light" onclick="closeModal()" style="border-radius:10px;margin-right:8px;">取消</button>
                        <button type="button" class="btn-primary-custom" onclick="submitBug()"><i class="fas fa-save me-1"></i> 保存</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="image-overlay" id="imageOverlay" onclick="this.style.display='none'">
    <img id="overlayImage" src="">
</div>
<div class="modal-overlay" id="confirmModal" style="display:none;">
    <div class="modal-card" style="max-width:420px;">
        <div class="modal-header">
            <div class="modal-title"><i class="fas fa-exclamation-triangle me-2" style="color:#f59e0b;"></i>确认操作</div>
        </div>
        <div class="modal-body">
            <p id="confirmMessage" style="margin:0;font-size:1rem;color:#334155;"></p>
        </div>
        <div style="padding:16px 24px;display:flex;justify-content:flex-end;gap:10px;border-top:1px solid #e8ecf1;">
            <button onclick="closeConfirmModal(false)" style="padding:8px 20px;border:1px solid #d1d5db;background:#f3f4f6;color:#374151;border-radius:8px;cursor:pointer;font-weight:600;">取消</button>
            <button onclick="closeConfirmModal(true)" style="padding:8px 20px;border:none;background:linear-gradient(135deg,#ef4444,#dc2626);color:white;border-radius:8px;cursor:pointer;font-weight:600;">确定</button>
        </div>
    </div>
</div>
<div class="modal-overlay" id="passwordModal" style="display:none;">
    <div class="modal-card" style="max-width:420px;">
        <div class="modal-header">
            <div class="modal-title"><i class="fas fa-lock me-2" style="color:#f59e0b;"></i>管理员权限验证</div>
        </div>
        <div class="modal-body">
            <p style="margin:0 0 12px 0;font-size:0.95rem;color:#334155;">删除图片需要管理员权限</p>
            <input type="password" id="superPasswordInput" class="form-control form-control-custom" placeholder="请输入管理员密码" style="width:100%;">
        </div>
        <div style="padding:16px 24px;display:flex;justify-content:flex-end;gap:10px;border-top:1px solid #e8ecf1;">
            <button onclick="closePasswordModal(null)" style="padding:8px 20px;border:1px solid #d1d5db;background:#f3f4f6;color:#374151;border-radius:8px;cursor:pointer;font-weight:600;">取消</button>
            <button onclick="closePasswordModal(document.getElementById('superPasswordInput').value)" style="padding:8px 20px;border:none;background:linear-gradient(135deg,#00a8cc,#0084a8);color:white;border-radius:8px;cursor:pointer;font-weight:600;">确认</button>
        </div>
    </div>
</div>
<script>
let currentModel = '';
let allBugs = [];
let currentPage = 1;
let totalBugs = 0;
let compressedImageBlobs = [];
let existingImages = [];
let editingExistingImage = false;
const initialSeries = '{{ series }}';
const initialModel = '{{ model }}';
let confirmResolve = null;

function addImagePreview(blob, existingId = null) {
    const area = document.getElementById('imagePreviewArea');
    const url = URL.createObjectURL(blob);
    const kb = (blob.size / 1024).toFixed(1);
    const mb = (blob.size / 1024 / 1024).toFixed(2);
    const sizeText = blob.size > 1024 * 1024 ? mb + ' MB' : kb + ' KB';
    const idx = compressedImageBlobs.length;
    const div = document.createElement('div');
    div.className = 'img-delete-wrap';
    div.style.cssText = 'display:inline-block;position:relative;';
    div.innerHTML = '<img src="' + url + '" style="max-width:120px;max-height:80px;border-radius:8px;border:2px solid #e8ecf1;display:block;"><button type="button" class="img-del-btn" onclick="removeImage(' + idx + ',' + (existingId || 'null') + ')"><i class="fas fa-times"></i></button><div style="font-size:0.7rem;color:#64748b;text-align:center;margin-top:2px;">' + sizeText + '</div>';
    area.appendChild(div);
}

async function removeImage(idx, existingId) {
    if (existingId) {
        if (!await showConfirm('确定要删除这张图片吗？此操作不可恢复。')) return;
        const superPwd = prompt('删除图片需要管理员权限，请输入管理员密码：');
        if (!superPwd) return;
        try {
            const loginResp = await fetch('/api/verify_super_admin', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({password: superPwd})
            });
            if (!loginResp.ok) { alert('管理员密码错误，权限验证失败'); return; }
            const editId = document.getElementById('editId').value;
            const resp = await fetch('/api/bugs/' + encodeURIComponent(currentModel) + '/' + editId + '/images/' + existingId, { method: 'DELETE' });
            if (!resp.ok) { const data = await resp.json(); alert(data.error || '删除失败'); return; }
            existingImages = existingImages.filter(img => img.id !== existingId);
            refreshImagePreviews();
        } catch (err) { alert('操作失败: ' + err.message); }
    } else {
        if (idx < compressedImageBlobs.length) {
            compressedImageBlobs.splice(idx, 1);
            refreshImagePreviews();
        }
    }
}

function refreshImagePreviews() {
    const area = document.getElementById('imagePreviewArea');
    area.innerHTML = '';
    existingImages.forEach((img, i) => {
        const div = document.createElement('div');
        div.className = 'img-delete-wrap';
        div.style.cssText = 'display:inline-block;position:relative;';
        div.innerHTML = '<img src="/api/bugs/' + encodeURIComponent(currentModel) + '/' + document.getElementById('editId').value + '/images/' + img.id + '" style="max-width:120px;max-height:80px;border-radius:8px;border:2px solid #e8ecf1;display:block;"><button type="button" class="img-del-btn" onclick="removeImage(0,' + img.id + ')"><i class="fas fa-times"></i></button><div style="font-size:0.7rem;color:#64748b;text-align:center;margin-top:2px;">已有</div>';
        area.appendChild(div);
    });
    compressedImageBlobs.forEach((blob, i) => {
        addImagePreview(blob);
    });
}

function clearAllImages() {
    compressedImageBlobs = [];
    existingImages = [];
    document.getElementById('bugImage').value = '';
    document.getElementById('imagePreviewArea').innerHTML = '';
    editingExistingImage = false;
}

function showConfirm(message) {
    return new Promise((resolve) => {
        confirmResolve = resolve;
        document.getElementById('confirmMessage').textContent = message;
        document.getElementById('confirmModal').style.display = 'flex';
    });
}

function closeConfirmModal(result) {
    document.getElementById('confirmModal').style.display = 'none';
    if (confirmResolve) {
        confirmResolve(result);
        confirmResolve = null;
    }
}

function compressImage(file, maxBytes) {
    return new Promise((resolve, reject) => {
        if (file.size <= maxBytes) { resolve(file); return; }
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = function() {
            URL.revokeObjectURL(url);
            let quality = 0.85;
            let w = img.width;
            let h = img.height;
            if (w > 2000 || h > 2000) { const s = 2000 / Math.max(w, h); w = Math.round(w * s); h = Math.round(h * s); }
            const tryCompress = (q) => {
                const canvas = document.createElement('canvas');
                canvas.width = w; canvas.height = h;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(img, 0, 0, w, h);
                canvas.toBlob(blob => {
                    if (!blob) { reject('压缩失败'); return; }
                    if (blob.size <= maxBytes || q < 0.1) { resolve(blob); }
                    else { tryCompress(q - 0.1); }
                }, 'image/jpeg', q);
            };
            tryCompress(quality);
        };
        img.onerror = () => { URL.revokeObjectURL(url); reject('图片加载失败'); };
        img.src = url;
    });
}

function showImagePreview(blob) {
    const preview = document.getElementById('imagePreview');
    const img = document.getElementById('previewImg');
    const info = document.getElementById('imageSizeInfo');
    const url = URL.createObjectURL(blob);
    img.src = url;
    const kb = (blob.size / 1024).toFixed(1);
    const mb = (blob.size / 1024 / 1024).toFixed(2);
    info.textContent = blob.size > 1024 * 1024 ? mb + ' MB' : kb + ' KB';
    preview.style.display = 'block';
    document.getElementById('pasteZone').style.display = 'none';
    editingExistingImage = false;
}

function clearPastedImage() {
    compressedImageBlob = null;
    compressedImageBlobs = [];
    existingImages = [];
    document.getElementById('bugImage').value = '';
    const area = document.getElementById('imagePreviewArea');
    if (area) area.innerHTML = '';
    editingExistingImage = false;
}

async function handleImageFile(file) {
    if (!file || !file.type.startsWith('image/')) { return; }
    const allowed = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
    if (!allowed.includes(file.type)) { return; }
    try {
        const blob = await compressImage(file, 5 * 1024 * 1024);
        compressedImageBlobs.push(blob);
        addImagePreview(blob);
    } catch (err) { console.error('图片处理失败:', err); }
}

document.addEventListener('paste', function(e) {
    if (!document.getElementById('bugModal').style.display || document.getElementById('bugModal').style.display === 'none') return;
    const items = e.clipboardData && e.clipboardData.items;
    if (!items) return;
    for (let i = 0; i < items.length; i++) {
        if (items[i].type.startsWith('image/')) {
            e.preventDefault();
            handleImageFile(items[i].getAsFile());
            return;
        }
    }
});

document.addEventListener('DOMContentLoaded', function() {
    const zone = document.getElementById('pasteZone');
    zone.addEventListener('dragover', e => { e.preventDefault(); zone.classList.add('drag-over'); });
    zone.addEventListener('dragleave', () => { zone.classList.remove('drag-over'); });
    zone.addEventListener('drop', e => { e.preventDefault(); zone.classList.remove('drag-over'); if (e.dataTransfer.files.length) handleImageFile(e.dataTransfer.files[0]); });
    document.getElementById('bugImage').addEventListener('change', async function() { for (let i = 0; i < this.files.length; i++) await handleImageFile(this.files[i]); });
});

async function loadModels() {
    const series = document.getElementById('seriesFilter').value;
    const modelSel = document.getElementById('modelFilter');
    modelSel.innerHTML = '<option value="">选择型号</option>';
    document.getElementById('versionFilter').innerHTML = '<option value="">全部版本</option>';
    document.getElementById('bugList').innerHTML = '<div class="empty-state"><i class="fas fa-hand-pointer"></i><div class="mt-3">请选择型号</div></div>';
    document.getElementById('addBtn').disabled = true;
    currentModel = '';
    if (!series) return;
    const resp = await fetch('/api/models?series=' + series);
    const models = await resp.json();
    models.forEach(m => { modelSel.innerHTML += '<option value="' + escapeHtml(m.name) + '">' + escapeHtml(m.name) + '</option>'; });
    if (initialModel && series === initialSeries) {
        modelSel.value = initialModel;
        if (modelSel.value === initialModel) onModelChange();
    }
}

async function loadVersions() {
    if (!currentModel) return;
    const resp = await fetch('/api/bugs/versions?model=' + encodeURIComponent(currentModel));
    const versions = await resp.json();
    let opts = '<option value="">请选择版本</option>';
    versions.forEach(v => opts += '<option value="' + escapeHtml(v) + '">' + escapeHtml(v) + '</option>');
    document.getElementById('versionFilter').innerHTML = opts;
}

function queryAll() {
    document.getElementById('versionFilter').value = '';
    loadBugs(1);
}

async function loadBugs(page) {
    if (!currentModel) return;
    page = page || 1;
    currentPage = page;
    const version = document.getElementById('versionFilter').value;
    let url = '/api/bugs?model=' + encodeURIComponent(currentModel) + '&page=' + page + '&per_page=20';
    if (version) url += '&version=' + encodeURIComponent(version);
    const resp = await fetch(url);
    const data = await resp.json();
    allBugs = data.results;
    totalBugs = data.total;
    document.querySelector('#bugCount span').textContent = data.total;
    renderBugs(allBugs);
    renderListPagination(data.total, data.page, data.per_page);
}

function onModelChange() {
    currentModel = document.getElementById('modelFilter').value;
    document.getElementById('addBtn').disabled = !currentModel;
    document.getElementById('queryBtn').disabled = !currentModel;
    isSearchMode = false;
    document.getElementById('searchInput').value = '';
    document.getElementById('pagination').style.display = 'none';
    if (currentModel) { 
        loadVersions(); 
        document.getElementById('bugList').innerHTML = '<div class="empty-state"><i class="fas fa-hand-pointer"></i><div class="mt-3">请选择版本或点击"查询全部"</div></div>';
        document.querySelector('#bugCount span').textContent = '0';
    }
    else { 
        document.getElementById('bugList').innerHTML = '<div class="empty-state"><i class="fas fa-hand-pointer"></i><div class="mt-3">请选择型号</div></div>'; 
        document.querySelector('#bugCount span').textContent = '0'; 
    }
}

function renderBugs(bugs) {
    const container = document.getElementById('bugList');
    if (!currentModel) { container.innerHTML = '<div class="empty-state"><i class="fas fa-hand-pointer"></i><div class="mt-3">请先选择系列和型号</div></div>'; return; }
    if (!bugs.length) { container.innerHTML = '<div class="empty-state"><i class="fas fa-inbox"></i><div class="mt-3">暂无Bug记录</div><div style="font-size:0.9rem;margin-top:5px;">点击上方"添加Bug"开始录入</div></div>'; return; }
    let html = '';
    bugs.forEach(bug => {
        html += '<div class="bug-item" data-bug-id="' + bug.id + '">';
        html += '<div class="bug-title"><i class="fas fa-exclamation-circle" style="color:#f59e0b;"></i> ' + escapeHtml(bug.title) + '</div>';
        html += '<div class="bug-field"><span class="bug-field-label"><i class="fas fa-code-branch me-1"></i>版本号:</span> <span class="bug-field-value">' + escapeHtml(bug.software_version) + '</span></div>';
        if (bug.cause) html += '<div class="bug-field"><span class="bug-field-label"><i class="fas fa-search me-1"></i>造成原因:</span> <span class="bug-field-value">' + escapeHtml(bug.cause) + '</span></div>';
        if (bug.workaround) html += '<div class="bug-field"><span class="bug-field-label"><i class="fas fa-shield-alt me-1"></i>临时规避:</span> <span class="bug-field-value">' + escapeHtml(bug.workaround) + '</span></div>';
        if (bug.solution) html += '<div class="bug-field"><span class="bug-field-label"><i class="fas fa-check-circle me-1" style="color:#10b981;"></i>解决方案:</span> <span class="bug-field-value">' + escapeHtml(bug.solution) + '</span></div>';
        if (bug.image_count > 0) html += '<div class="bug-field" id="bug-images-' + bug.id + '"><i class="fas fa-images me-1" style="color:#6366f1;"></i> 加载图片中...</div>';
        html += '<div class="bug-meta">';
        html += '<span><i class="fas fa-clock me-1"></i>' + (bug.created_at || '') + '</span>';
        if (bug.updated_at && bug.updated_at !== bug.created_at) html += '<span><i class="fas fa-edit me-1"></i>' + bug.updated_at + '</span>';
        html += '<div style="flex:1;"></div>';
        html += '<button class="btn-sm-custom btn-edit" onclick="editBug(' + bug.id + ')"><i class="fas fa-pen me-1"></i>编辑</button>';
        html += '<button class="btn-danger-custom" style="margin-left:6px;" onclick="deleteBug(' + bug.id + ')"><i class="fas fa-trash me-1"></i>删除</button>';
        html += '</div></div>';
    });
    container.innerHTML = html;
    bugs.forEach(bug => {
        if (bug.image_count > 0) {
            loadBugImages(bug.id);
        }
    });
}

async function loadBugImages(bugId) {
    try {
        const resp = await fetch('/api/bugs/' + encodeURIComponent(currentModel) + '/' + bugId + '/images');
        const images = await resp.json();
        const container = document.getElementById('bug-images-' + bugId);
        if (!container) return;
        if (images.length === 0) {
            container.innerHTML = '';
            return;
        }
        let html = '<i class="fas fa-images me-1" style="color:#6366f1;"></i> ';
        images.forEach((img, idx) => {
            html += '<img src="/api/bugs/' + encodeURIComponent(currentModel) + '/' + bugId + '/images/' + img.id + '" style="max-width:80px;max-height:60px;border-radius:6px;border:2px solid #e8ecf1;margin-right:6px;cursor:pointer;" onclick="showImage(this.src)" alt="Bug图片">';
        });
        container.innerHTML = html;
    } catch (err) {
        console.error('加载Bug图片失败:', err);
    }
}

function escapeHtml(text) {
    if (!text) return '';
    const d = document.createElement('div');
    d.textContent = text;
    return d.innerHTML;
}

function showImage(src) {
    document.getElementById('overlayImage').src = src;
    document.getElementById('imageOverlay').style.display = 'flex';
}

function openAddModal() {
    if (!currentModel) { alert('请先选择型号'); return; }
    document.getElementById('modalTitle').textContent = '添加Bug - ' + currentModel;
    document.getElementById('editId').value = '';
    document.getElementById('bugModel').value = currentModel;
    document.getElementById('bugModelDisplay').value = currentModel;
    document.getElementById('bugVersion').value = '';
    document.getElementById('bugTitle').value = '';
    document.getElementById('bugCause').value = '';
    document.getElementById('bugWorkaround').value = '';
    document.getElementById('bugSolution').value = '';
    document.getElementById('bugImage').value = '';
    clearPastedImage();
    document.getElementById('bugModal').style.display = 'flex';
}

async function editBug(id) {
    const bug = allBugs.find(b => b.id === id);
    if (!bug) return;
    document.getElementById('modalTitle').textContent = '编辑Bug - ' + currentModel;
    document.getElementById('editId').value = id;
    document.getElementById('bugModel').value = currentModel;
    document.getElementById('bugModelDisplay').value = currentModel;
    document.getElementById('bugVersion').value = bug.software_version;
    document.getElementById('bugTitle').value = bug.title;
    document.getElementById('bugCause').value = bug.cause || '';
    document.getElementById('bugWorkaround').value = bug.workaround || '';
    document.getElementById('bugSolution').value = bug.solution || '';
    document.getElementById('bugImage').value = '';
    clearAllImages();
    if (bug.image_count > 0) {
        try {
            const resp = await fetch('/api/bugs/' + encodeURIComponent(currentModel) + '/' + id + '/images');
            existingImages = await resp.json();
            refreshImagePreviews();
        } catch (err) { console.error('加载图片失败:', err); }
    }
    document.getElementById('bugModal').style.display = 'flex';
}

function closeModal() {
    document.getElementById('bugModal').style.display = 'none';
    clearPastedImage();
}

function onImgDelete() {
    if (editingExistingImage) {
        deleteBugImage();
    } else {
        clearPastedImage();
    }
}

async function deleteBugImage() {
    const editId = document.getElementById('editId').value;
    if (!editId) return;
    if (!await showConfirm('确定要删除此Bug的图片吗？此操作不可恢复。')) return;
    const superPwd = prompt('删除图片需要管理员权限，请输入管理员密码：');
    if (!superPwd) return;
    try {
        const loginResp = await fetch('/api/verify_super_admin', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({password: superPwd})
        });
        if (!loginResp.ok) { alert('管理员密码错误，权限验证失败'); return; }
        const resp = await fetch('/api/bugs/' + encodeURIComponent(currentModel) + '/' + editId + '/image', { method: 'DELETE' });
        const data = await resp.json();
        if (resp.ok) {
            clearAllImages();
            loadBugs(currentPage);
        } else {
            alert(data.error || '删除失败');
        }
    } catch (err) { alert('操作失败: ' + err.message); }
}

async function deleteBugImageFromList(bugId) {
    if (!await showConfirm('确定要删除此Bug的图片吗？此操作不可恢复。')) return;
    const superPwd = await showPasswordModal();
    if (!superPwd) return;
    try {
        const loginResp = await fetch('/api/verify_super_admin', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({password: superPwd})
        });
        if (!loginResp.ok) { alert('管理员密码错误，权限验证失败'); return; }
        const resp = await fetch('/api/bugs/' + encodeURIComponent(currentModel) + '/' + bugId + '/image', { method: 'DELETE' });
        const data = await resp.json();
        if (resp.ok) { loadBugs(currentPage); }
        else { alert(data.error || '删除失败'); }
    } catch (err) { alert('操作失败: ' + err.message); }
}

async function deleteBugImageFromListByModel(model, bugId) {
    if (!await showConfirm('确定要删除此Bug的图片吗？此操作不可恢复。')) return;
    const superPwd = await showPasswordModal();
    if (!superPwd) return;
    try {
        const loginResp = await fetch('/api/verify_super_admin', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({password: superPwd})
        });
        if (!loginResp.ok) { alert('管理员密码错误，权限验证失败'); return; }
        const resp = await fetch('/api/bugs/' + encodeURIComponent(model) + '/' + bugId + '/image', { method: 'DELETE' });
        const data = await resp.json();
        if (resp.ok) { doSearch(currentPage); }
        else { alert(data.error || '删除失败'); }
    } catch (err) { alert('操作失败: ' + err.message); }
}

async function submitBug() {
    const editId = document.getElementById('editId').value;
    const model = document.getElementById('bugModel').value;
    const version = document.getElementById('bugVersion').value.trim();
    const title = document.getElementById('bugTitle').value.trim();
    const cause = document.getElementById('bugCause').value.trim();
    const workaround = document.getElementById('bugWorkaround').value.trim();
    const solution = document.getElementById('bugSolution').value.trim();
    if (!model || !version || !title) { alert('型号、版本号和标题为必填项'); return; }
    const fd = new FormData();
    fd.append('model', model);
    fd.append('software_version', version);
    fd.append('title', title);
    fd.append('cause', cause);
    fd.append('workaround', workaround);
    fd.append('solution', solution);
    compressedImageBlobs.forEach((blob, i) => {
        fd.append('image' + i, blob, 'bug_image_' + i + '.jpg');
    });
    try {
        let resp;
        if (editId) {
            resp = await fetch('/api/bugs/' + encodeURIComponent(model) + '/' + editId, { method: 'PUT', body: fd });
        } else {
            resp = await fetch('/api/bugs', { method: 'POST', body: fd });
        }
        const data = await resp.json();
        if (!resp.ok) { alert(data.error || '操作失败'); return; }
        closeModal();
        loadVersions();
        loadBugs(currentPage);
    } catch (err) {
        alert('操作失败: ' + err.message);
    }
}

async function deleteBug(id) {
    if (!await showConfirm('确定要删除这条Bug记录吗？')) return;
    try {
        const resp = await fetch('/api/bugs/' + encodeURIComponent(currentModel) + '/' + id, { method: 'DELETE' });
        if (resp.ok) { loadVersions(); loadBugs(currentPage); }
        else { const d = await resp.json(); alert(d.error || '删除失败'); }
    } catch (err) { alert('删除失败: ' + err.message); }
}

document.getElementById('seriesFilter').onchange = loadModels;
document.getElementById('modelFilter').onchange = onModelChange;
document.getElementById('versionFilter').onchange = function() {
    loadBugs(1);
};
document.getElementById('bugModal').onclick = function(e) { if (e.target === this) closeModal(); };
document.getElementById('searchInput').onkeydown = function(e) { if (e.key === 'Enter') doSearch(1); };

let isSearchMode = false;

async function doSearch(page) {
    const q = document.getElementById('searchInput').value.trim();
    if (!q) { isSearchMode = false; if (currentModel) loadBugs(); else { document.getElementById('bugList').innerHTML = '<div class="empty-state"><i class="fas fa-hand-pointer"></i><div class="mt-3">请先选择系列和型号</div></div>'; document.getElementById('pagination').style.display = 'none'; } return; }
    isSearchMode = true;
    const series = document.getElementById('seriesFilter').value;
    const model = currentModel;
    let url = '/api/bugs/search?q=' + encodeURIComponent(q) + '&page=' + page;
    if (model) url += '&model=' + encodeURIComponent(model);
    else if (series) url += '&series=' + encodeURIComponent(series);
    const resp = await fetch(url);
    const data = await resp.json();
    document.querySelector('#bugCount span').textContent = data.total;
    allBugs = data.results;
    renderSearchResults(data.results, q, series, model);
    renderPagination(data.total, data.page, data.per_page);
}

function renderSearchResults(bugs, query, series, model) {
    const container = document.getElementById('bugList');
    if (!bugs.length) { container.innerHTML = '<div class="empty-state"><i class="fas fa-search"></i><div class="mt-3">未找到匹配的Bug</div></div>'; return; }
    let scope = '跨所有型号和版本';
    if (model) scope = '在 ' + escapeHtml(model) + ' 型号中';
    else if (series) scope = '在 ' + escapeHtml(series) + ' 系列中';
    let html = '<div style="margin-bottom:12px;padding:8px 14px;background:#fffbeb;border-radius:10px;font-size:0.9rem;color:#92400e;"><i class="fas fa-search me-1"></i> 搜索 "<strong>' + escapeHtml(query) + '</strong>" 的结果（' + scope + '）</div>';
    bugs.forEach(bug => {
        html += '<div class="bug-item">';
        html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;"><span class="bug-title" style="margin-bottom:0;"><i class="fas fa-exclamation-circle" style="color:#f59e0b;"></i> ' + escapeHtml(bug.title) + '</span><span style="background:linear-gradient(135deg,#e0f2fe,#bae6fd);color:#0369a1;padding:4px 12px;border-radius:16px;font-size:0.8rem;font-weight:600;">' + escapeHtml(bug.model) + '</span></div>';
        html += '<div class="bug-field"><span class="bug-field-label"><i class="fas fa-code-branch me-1"></i>版本号:</span> <span class="bug-field-value">' + escapeHtml(bug.software_version) + '</span></div>';
        if (bug.cause) html += '<div class="bug-field"><span class="bug-field-label"><i class="fas fa-search me-1"></i>造成原因:</span> <span class="bug-field-value">' + escapeHtml(bug.cause) + '</span></div>';
        if (bug.workaround) html += '<div class="bug-field"><span class="bug-field-label"><i class="fas fa-shield-alt me-1"></i>临时规避:</span> <span class="bug-field-value">' + escapeHtml(bug.workaround) + '</span></div>';
        if (bug.solution) html += '<div class="bug-field"><span class="bug-field-label"><i class="fas fa-check-circle me-1" style="color:#10b981;"></i>解决方案:</span> <span class="bug-field-value">' + escapeHtml(bug.solution) + '</span></div>';
        if (bug.image_count > 0) html += '<div class="bug-field"><i class="fas fa-images me-1" style="color:#6366f1;"></i> ' + bug.image_count + ' 张图片</div>';
        html += '<div class="bug-meta">';
        html += '<span><i class="fas fa-clock me-1"></i>' + (bug.created_at || '') + '</span>';
        html += '</div></div>';
    });
    container.innerHTML = html;
}

function renderPagination(total, currentPage, perPage) {
    const container = document.getElementById('pagination');
    const totalPages = Math.ceil(total / perPage);
    if (totalPages <= 1) { container.style.display = 'none'; return; }
    container.style.display = 'flex';
    let html = '';
    if (currentPage > 1) html += '<button class="btn-sm-custom" style="background:#e2e8f0;color:#475569;" onclick="doSearch(' + (currentPage-1) + ')"><i class="fas fa-chevron-left"></i></button>';
    let start = Math.max(1, currentPage - 2);
    let end = Math.min(totalPages, start + 4);
    if (end - start < 4) start = Math.max(1, end - 4);
    for (let i = start; i <= end; i++) {
        if (i === currentPage) html += '<button class="btn-sm-custom" style="background:linear-gradient(135deg,#00a8cc,#0084a8);color:white;">' + i + '</button>';
        else html += '<button class="btn-sm-custom" style="background:#e2e8f0;color:#475569;" onclick="doSearch(' + i + ')">' + i + '</button>';
    }
    if (currentPage < totalPages) html += '<button class="btn-sm-custom" style="background:#e2e8f0;color:#475569;" onclick="doSearch(' + (currentPage+1) + ')"><i class="fas fa-chevron-right"></i></button>';
    html += '<span style="font-size:0.85rem;color:#94a3b8;margin-left:8px;">共 ' + total + ' 条</span>';
    container.innerHTML = html;
}

if (initialSeries) {
    document.getElementById('seriesFilter').value = initialSeries;
    loadModels();
}
</script>
</body>
</html>
'''

# ========== 模板: LIS_ISSUES_HTML (LIS问题功能) ==========
LIS_ISSUES_HTML = '''
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title>LIS问题排查</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%); padding: 20px; min-height: 100vh; }
        .container { max-width: 1200px; margin: 0 auto; }
        .ivd-card { background: white; border-radius: 16px; padding: 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border: 1px solid #e8ecf1; margin-bottom: 24px; }
        .header-bar { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 16px; padding: 24px 28px; margin-bottom: 24px; color: white; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 20px rgba(245,158,11,0.3); }
        .header-bar h1 { font-size: 1.5rem; font-weight: 700; margin: 0; }
        .header-bar .back-link { color: white; text-decoration: none; font-size: 0.95rem; opacity: 0.9; transition: opacity 0.2s; }
        .header-bar .back-link:hover { opacity: 1; }
        .section-title { font-size: 1.15rem; font-weight: 700; color: #1e293b; margin-bottom: 16px; display: flex; align-items: center; gap: 10px; }
        .section-title i { color: #f59e0b; }
        .form-label-custom { font-weight: 600; color: #475569; margin-bottom: 6px; font-size: 0.9rem; }
        .form-control-custom { border-radius: 10px; border: 2px solid #e8ecf1; padding: 10px 14px; transition: border-color 0.2s; }
        .form-control-custom:focus { border-color: #f59e0b; box-shadow: 0 0 0 3px rgba(245,158,11,0.15); outline: none; }
        .btn-primary-custom { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; border: none; border-radius: 10px; padding: 10px 20px; font-weight: 600; cursor: pointer; transition: all 0.3s; }
        .btn-primary-custom:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(245,158,11,0.4); color: white; }
        .btn-copy { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: white; border: none; border-radius: 8px; padding: 8px 16px; font-weight: 600; cursor: pointer; transition: all 0.2s; font-size: 0.85rem; }
        .btn-copy:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(59,130,246,0.4); }
        .result-box { background: #1e293b; border-radius: 12px; padding: 20px; color: #e2e8f0; font-family: 'Courier New', monospace; font-size: 0.95rem; line-height: 1.8; position: relative; margin-top: 16px; }
        .result-box .copy-btn { position: absolute; top: 12px; right: 12px; }
        .same-subnet { background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border: 2px solid #22c55e; border-radius: 12px; padding: 16px 20px; color: #15803d; font-weight: 600; display: flex; align-items: center; gap: 10px; margin-top: 16px; }
        .diff-subnet { background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border: 2px solid #f59e0b; border-radius: 12px; padding: 16px 20px; color: #92400e; font-weight: 600; display: flex; align-items: center; gap: 10px; margin-top: 16px; }
        .route-rule-item { background: #f8fafc; border-radius: 12px; padding: 16px; margin-bottom: 12px; border: 1px solid #e8ecf1; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
        .route-rule-item .cmd-text { font-family: 'Courier New', monospace; font-size: 0.88rem; color: #334155; word-break: break-all; flex: 1; }
        .route-rule-item .rule-meta { font-size: 0.8rem; color: #94a3b8; margin-top: 4px; }
        .route-rule-item .del-btn { background: #fee2e2; color: #ef4444; border: none; border-radius: 8px; width: 32px; height: 32px; cursor: pointer; font-size: 0.9rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s; flex-shrink: 0; }
        .route-rule-item .del-btn:hover { background: #ef4444; color: white; }
        .upload-zone { border: 2px dashed #cbd5e1; border-radius: 12px; padding: 30px 20px; text-align: center; cursor: pointer; transition: all 0.2s; background: #f8fafc; }
        .upload-zone:hover { border-color: #f59e0b; background: #fffbeb; }
        .upload-zone.drag-over { border-color: #f59e0b; background: #fef3c7; }
        .upload-zone i { font-size: 2.5rem; color: #94a3b8; }
        .upload-zone .upload-text { margin-top: 10px; color: #64748b; font-weight: 600; }
        .upload-zone .upload-hint { font-size: 0.82rem; color: #94a3b8; margin-top: 6px; }
        .log-file-item { background: #f8fafc; border-radius: 12px; padding: 14px 18px; margin-bottom: 10px; border: 1px solid #e8ecf1; display: flex; justify-content: space-between; align-items: center; }
        .log-file-item .file-info { display: flex; align-items: center; gap: 10px; }
        .log-file-item .file-name { font-weight: 600; color: #334155; }
        .log-file-item .file-size { font-size: 0.82rem; color: #94a3b8; }
        .log-file-item .del-btn { background: #fee2e2; color: #ef4444; border: none; border-radius: 8px; width: 28px; height: 28px; cursor: pointer; font-size: 0.8rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
        .log-file-item .del-btn:hover { background: #ef4444; color: white; }
        .parse-result-item { background: #f8fafc; border-radius: 12px; padding: 16px; margin-bottom: 12px; border: 1px solid #e8ecf1; }
        .parse-result-item .result-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
        .parse-result-item .result-title { font-weight: 700; color: #1e293b; }
        .parse-result-item .result-tag { font-size: 0.78rem; padding: 3px 10px; border-radius: 20px; font-weight: 600; }
        .tag-pass { background: #dcfce7; color: #15803d; }
        .tag-fail { background: #fee2e2; color: #991b1b; }
        .tag-warn { background: #fef3c7; color: #92400e; }
        .parse-result-item .result-content { font-size: 0.9rem; color: #475569; line-height: 1.6; }
        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); justify-content: center; align-items: center; z-index: 9999; padding: 20px; backdrop-filter: blur(4px); }
        .modal-card { background: white; border-radius: 20px; width: min(100%, 600px); max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 80px rgba(0,0,0,0.25); }
        .modal-header { padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #f0f4f8; background: linear-gradient(135deg, #f8fafc 0%, #f0f4f8 100%); }
        .modal-title { font-size: 1.2rem; font-weight: 700; color: #d97706; }
        .modal-close { border: none; background: #f1f5f9; color: #64748b; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; font-size: 1.3rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
        .modal-close:hover { background: #e2e8f0; color: #ef4444; }
        .modal-body { padding: 24px; }
        .tab-bar { display: flex; gap: 0; margin-bottom: 24px; background: #f1f5f9; border-radius: 12px; padding: 4px; }
        .tab-btn { flex: 1; padding: 12px 16px; border: none; background: transparent; border-radius: 10px; font-weight: 600; font-size: 0.95rem; cursor: pointer; transition: all 0.2s; color: #64748b; }
        .tab-btn.active { background: white; color: #d97706; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        .tab-btn:hover:not(.active) { color: #92400e; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .filter-bar { display: flex; gap: 12px; align-items: center; margin-bottom: 20px; flex-wrap: wrap; }
        .stat-badge { display: inline-flex; align-items: center; gap: 6px; background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); padding: 8px 16px; border-radius: 20px; font-weight: 600; color: #92400e; font-size: 0.9rem; }
        .empty-state { text-align: center; padding: 60px 20px; color: #94a3b8; }
        .empty-state i { font-size: 4rem; opacity: 0.4; }
        .divider { height: 1px; background: #e8ecf1; margin: 24px 0; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 10px; }
    </style>
</head>
<body>
<div class="container">
    <div class="header-bar">
        <div>
            <h1><i class="fas fa-exchange-alt me-2"></i> LIS问题排查</h1>
            <div style="font-size:0.9rem;opacity:0.85;margin-top:4px;">跨网段路由配置 & LIS日志分析</div>
        </div>
        <a href="/" class="back-link"><i class="fas fa-arrow-left me-1"></i> 返回主页</a>
    </div>

    <div class="tab-bar">
        <button class="tab-btn active" onclick="switchTab('route', this)"><i class="fas fa-route me-1"></i> 跨网段路由</button>
        <button class="tab-btn" onclick="switchTab('log', this)"><i class="fas fa-file-alt me-1"></i> LIS日志分析</button>
    </div>

    <!-- 功能1: 跨网段路由指令生成 -->
    <div id="tab-route" class="tab-content active">
        <div class="ivd-card">
            <div class="section-title"><i class="fas fa-network-wired"></i> 网段判断与路由指令生成</div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label-custom"><i class="fas fa-desktop me-1" style="color:#3b82f6;"></i> 设备IP地址</label>
                    <input type="text" id="deviceIp" class="form-control form-control-custom" placeholder="例: 192.192.208.126">
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom"><i class="fas fa-server me-1" style="color:#22c55e;"></i> LIS服务器IP地址</label>
                    <input type="text" id="lisIp" class="form-control form-control-custom" placeholder="例: 192.192.10.50">
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom"><i class="fas fa-shield-alt me-1" style="color:#f59e0b;"></i> 子网掩码</label>
                    <input type="text" id="subnetMask" class="form-control form-control-custom" placeholder="例: 255.255.255.0 或 /24">
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom"><i class="fas fa-door-open me-1" style="color:#8b5cf6;"></i> 网关地址</label>
                    <input type="text" id="gateway" class="form-control form-control-custom" placeholder="例: 192.192.208.1">
                </div>
                <div class="col-md-4">
                    <label class="form-label-custom"><i class="fas fa-ethernet me-1" style="color:#06b6d4;"></i> 网络接口名</label>
                    <input type="text" id="interfaceName" class="form-control form-control-custom" placeholder="例: lan1" value="lan1">
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button class="btn-primary-custom w-100" onclick="generateRoute()"><i class="fas fa-cogs me-1"></i> 生成路由指令</button>
                </div>
            </div>
            <div id="routeResult"></div>
        </div>

        <div class="ivd-card">
            <div class="section-title"><i class="fas fa-list-ol"></i> 已添加的路由规则</div>
            <div id="routeRulesList">
                <div class="empty-state" style="padding:30px;"><i class="fas fa-route" style="font-size:2.5rem;"></i><div class="mt-2" style="font-size:0.95rem;">暂无路由规则，请先生成并添加</div></div>
            </div>
        </div>
    </div>

    <!-- 功能2: LIS日志上传与分析 -->
    <div id="tab-log" class="tab-content">
        <div class="ivd-card">
            <div class="section-title"><i class="fas fa-upload"></i> LIS协议比对分析</div>
            <div class="filter-bar">
                <select id="logSeriesFilter" class="form-select form-control-custom" style="max-width:160px;">
                    <option value="">选择系列</option>
                    <option value="SMART">SMART</option>
                    <option value="VENUS">VENUS</option>
                </select>
                <select id="logModelFilter" class="form-select form-control-custom" style="max-width:200px;">
                    <option value="">选择型号</option>
                </select>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label-custom"><i class="fas fa-file-contract me-1" style="color:#8b5cf6;"></i> HL7协议模板</label>
                    <div id="templateStatus" style="display:none;">
                        <div class="log-file-item" style="border-color:#22c55e;background:#f0fdf4;">
                            <div class="file-info">
                                <i class="fas fa-check-circle" style="color:#22c55e;font-size:1.1rem;"></i>
                                <div>
                                    <div class="file-name" id="templateFileName" style="color:#15803d;"></div>
                                    <div class="file-size" id="templateUpdateTime"></div>
                                </div>
                            </div>
                            <div style="display:flex;gap:6px;">
                                <button id="viewPdfBtn" class="del-btn" style="background:#dbeafe;color:#2563eb;display:none;" onclick="viewTemplatePdf()" title="查看PDF"><i class="fas fa-file-pdf"></i></button>
                                <button class="del-btn" style="background:#fef3c7;color:#d97706;" onclick="editTemplateContent()" title="编辑模板文本"><i class="fas fa-edit"></i></button>
                                <button class="del-btn" style="background:#fef3c7;color:#d97706;" onclick="replaceTemplate()" title="替换模板"><i class="fas fa-sync-alt"></i></button>
                                <button class="del-btn" onclick="deleteTemplate()" title="删除模板"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                    </div>
                    <div id="templateUploadArea">
                        <div class="upload-zone" id="protocolUploadZone" style="min-height:120px;">
                            <i class="fas fa-file-code" style="font-size:1.8rem;"></i>
                            <div class="upload-text" style="font-size:0.9rem;">点击或拖拽上传协议模板</div>
                            <div class="upload-hint">支持 PDF / .txt / .log / .hl7 单文件，上传后按型号保存</div>
                            <input type="file" id="protocolFileInput" accept=".pdf,.txt,.log,.hl7" style="display:none">
                        </div>
                    </div>
                    <div id="protocolUploading" style="display:none;text-align:center;padding:20px;">
                        <i class="fas fa-spinner fa-spin" style="font-size:1.5rem;color:#8b5cf6;"></i>
                        <div style="margin-top:8px;color:#64748b;">正在保存模板...</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label-custom"><i class="fas fa-file-alt me-1" style="color:#f59e0b;"></i> LIS日志文件（待比对）</label>
                    <div class="upload-zone" id="logUploadZone" style="min-height:120px;">
                        <i class="fas fa-file-upload" style="font-size:1.8rem;"></i>
                        <div class="upload-text" style="font-size:0.9rem;">点击或拖拽上传日志文件</div>
                        <div class="upload-hint">.txt / .log 单文件</div>
                        <input type="file" id="logFileInput" accept=".txt,.log" style="display:none">
                    </div>
                    <div id="logFileInfo" style="margin-top:8px;display:none;">
                        <div class="log-file-item">
                            <div class="file-info">
                                <i class="fas fa-file-alt" style="color:#f59e0b;font-size:1.1rem;"></i>
                                <div>
                                    <div class="file-name" id="logFileName"></div>
                                    <div class="file-size" id="logFileSize"></div>
                                </div>
                            </div>
                            <button class="del-btn" onclick="clearLogFile()"><i class="fas fa-times"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            <div style="margin-top:16px;text-align:right;">
                <button class="btn-primary-custom" id="parseLogBtn" onclick="parseLogFile()" disabled><i class="fas fa-search me-1"></i> 开始比对</button>
            </div>
        </div>

        <div class="ivd-card" id="compareResultCard" style="display:none;">
            <div class="section-title"><i class="fas fa-clipboard-check"></i> 比对结果</div>
            <div id="compareSummary" style="margin-bottom:16px;"></div>
            <div style="display:flex;gap:0;border:1px solid #e8ecf1;border-radius:12px;overflow:hidden;height:500px;">
                <div style="flex:1;display:flex;flex-direction:column;border-right:2px solid #e8ecf1;">
                    <div style="padding:10px 16px;background:#f8fafc;font-weight:700;color:#475569;border-bottom:1px solid #e8ecf1;font-size:0.9rem;"><i class="fas fa-file-alt me-1" style="color:#64748b;"></i> 原始日志</div>
                    <div id="logLeftPanel" style="flex:1;overflow:auto;padding:0;font-family:'Courier New',monospace;font-size:0.82rem;line-height:1.7;"></div>
                </div>
                <div style="flex:1;display:flex;flex-direction:column;">
                    <div style="padding:10px 16px;background:#f8fafc;font-weight:700;color:#475569;border-bottom:1px solid #e8ecf1;font-size:0.9rem;"><i class="fas fa-exclamation-circle me-1" style="color:#f59e0b;"></i> 问题标注</div>
                    <div id="logRightPanel" style="flex:1;overflow:auto;padding:0;font-family:'Courier New',monospace;font-size:0.82rem;line-height:1.7;"></div>
                </div>
            </div>
        </div>
        <div class="ivd-card" id="compareEmptyCard">
            <div class="section-title"><i class="fas fa-clipboard-check"></i> 比对结果</div>
            <div class="empty-state" style="padding:30px;"><i class="fas fa-file-alt" style="font-size:2.5rem;"></i><div class="mt-2" style="font-size:0.95rem;">请选择型号并上传日志文件后开始比对</div></div>
        </div>
    </div>
</div>

<div class="modal-overlay" id="editTemplateModal" style="display:none;">
    <div class="modal-card" style="max-width:800px;">
        <div class="modal-header">
            <div class="modal-title"><i class="fas fa-edit me-2" style="color:#8b5cf6;"></i>编辑HL7协议模板文本</div>
            <button class="modal-close" onclick="closeEditTemplate()">&times;</button>
        </div>
        <div class="modal-body">
            <div style="margin-bottom:12px;padding:10px 14px;background:#fffbeb;border-radius:8px;font-size:0.85rem;color:#92400e;">
                <i class="fas fa-info-circle me-1"></i>此文本用于与日志进行HL7协议比对，请确保包含完整的HL7消息示例行（含 | 分隔符的行）
            </div>
            <input type="hidden" id="editTemplateId" value="">
            <textarea id="editTemplateContent" class="form-control form-control-custom" rows="18" style="font-family:'Courier New',monospace;font-size:0.88rem;line-height:1.6;" placeholder="HL7协议消息示例..."></textarea>
        </div>
        <div style="padding:16px 24px;display:flex;justify-content:flex-end;gap:10px;border-top:1px solid #e8ecf1;">
            <button onclick="closeEditTemplate()" style="padding:8px 20px;border:1px solid #d1d5db;background:#f3f4f6;color:#374151;border-radius:8px;cursor:pointer;font-weight:600;">取消</button>
            <button onclick="saveTemplateContent()" style="padding:8px 20px;border:none;background:linear-gradient(135deg,#8b5cf6,#7c3aed);color:white;border-radius:8px;cursor:pointer;font-weight:600;"><i class="fas fa-save me-1"></i>保存</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="lisPasswordModal" style="display:none;">
    <div class="modal-card" style="max-width:420px;">
        <div class="modal-header">
            <div class="modal-title"><i class="fas fa-lock me-2" style="color:#f59e0b;"></i>管理员权限验证</div>
        </div>
        <div class="modal-body">
            <p style="margin:0 0 12px 0;font-size:0.95rem;color:#334155;">修改协议模板需要管理员权限</p>
            <input type="password" id="lisSuperPasswordInput" class="form-control form-control-custom" placeholder="请输入管理员密码" style="width:100%;">
        </div>
        <div style="padding:16px 24px;display:flex;justify-content:flex-end;gap:10px;border-top:1px solid #e8ecf1;">
            <button onclick="closeLisPasswordModal(null)" style="padding:8px 20px;border:1px solid #d1d5db;background:#f3f4f6;color:#374151;border-radius:8px;cursor:pointer;font-weight:600;">取消</button>
            <button onclick="closeLisPasswordModal(document.getElementById('lisSuperPasswordInput').value)" style="padding:8px 20px;border:none;background:linear-gradient(135deg,#f59e0b,#d97706);color:white;border-radius:8px;cursor:pointer;font-weight:600;">确认</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="alertModal" style="display:none;">
    <div class="modal-card" style="max-width:420px;">
        <div class="modal-header">
            <div class="modal-title"><i class="fas fa-info-circle me-2" style="color:#f59e0b;"></i>提示</div>
        </div>
        <div class="modal-body">
            <p id="alertMessage" style="margin:0;font-size:1rem;color:#334155;"></p>
        </div>
        <div style="padding:16px 24px;display:flex;justify-content:center;gap:10px;border-top:1px solid #e8ecf1;">
            <button onclick="closeAlertModal()" style="padding:8px 30px;border:none;background:linear-gradient(135deg,#f59e0b,#d97706);color:white;border-radius:8px;cursor:pointer;font-weight:600;">确定</button>
        </div>
    </div>
</div>

<script>
let routeRules = [];
let selectedLogFile = null;

function escapeHtml(text) {
    if (!text) return '';
    const d = document.createElement('div');
    d.textContent = text;
    return d.innerHTML;
}

function switchTab(tab, el) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    document.getElementById('tab-' + tab).classList.add('active');
    el.classList.add('active');
}

function showAlert(msg) {
    document.getElementById('alertMessage').textContent = msg;
    document.getElementById('alertModal').style.display = 'flex';
}
function closeAlertModal() {
    document.getElementById('alertModal').style.display = 'none';
}

function ipToInt(ip) {
    const parts = ip.split('.').map(Number);
    return ((parts[0] << 24) | (parts[1] << 16) | (parts[2] << 8) | parts[3]) >>> 0;
}

function maskToCidr(mask) {
    const m = ipToInt(mask);
    return m.toString(2).split('').filter(c => c === '1').length;
}

function getNetworkAddress(ip, mask) {
    const ipInt = ipToInt(ip);
    const maskInt = ipToInt(mask);
    return intToIp(ipInt & maskInt);
}

function intToIp(num) {
    return [(num >>> 24) & 255, (num >>> 16) & 255, (num >>> 8) & 255, num & 255].join('.');
}

function isValidIp(ip) {
    const parts = ip.split('.');
    if (parts.length !== 4) return false;
    return parts.every(p => { const n = Number(p); return !isNaN(n) && n >= 0 && n <= 255 && p === String(n); });
}

function cidrToMask(cidr) {
    const n = parseInt(cidr);
    if (isNaN(n) || n < 0 || n > 32) return null;
    const mask = n === 0 ? 0 : (~0 << (32 - n)) >>> 0;
    return intToIp(mask);
}

function parseSubnetMask(input) {
    input = input.trim();
    if (input.startsWith('/')) {
        const mask = cidrToMask(input.substring(1));
        if (mask) return mask;
    }
    if (/^\d+$/.test(input)) {
        const mask = cidrToMask(input);
        if (mask) return mask;
    }
    if (isValidIp(input)) return input;
    return null;
}

function generateRoute() {
    const deviceIp = document.getElementById('deviceIp').value.trim();
    const lisIp = document.getElementById('lisIp').value.trim();
    const maskInput = document.getElementById('subnetMask').value.trim();
    const gateway = document.getElementById('gateway').value.trim();
    const iface = document.getElementById('interfaceName').value.trim() || 'lan1';

    if (!isValidIp(deviceIp)) { showAlert('请输入有效的设备IP地址'); return; }
    if (!isValidIp(lisIp)) { showAlert('请输入有效的LIS服务器IP地址'); return; }
    if (!maskInput) { showAlert('请输入子网掩码'); return; }
    const subnetMask = parseSubnetMask(maskInput);
    if (!subnetMask) { showAlert('子网掩码格式无效，请输入如 255.255.255.0 或 /24'); return; }
    if (!isValidIp(gateway)) { showAlert('请输入有效的网关地址'); return; }

    const deviceNetwork = getNetworkAddress(deviceIp, subnetMask);
    const lisNetwork = getNetworkAddress(lisIp, subnetMask);
    const cidr = maskToCidr(subnetMask);
    const sameSubnet = deviceNetwork === lisNetwork;

    let html = '';
    if (sameSubnet) {
        html += '<div class="same-subnet"><i class="fas fa-check-circle" style="font-size:1.5rem;"></i><div><div>设备与LIS服务器在同一网段</div><div style="font-size:0.85rem;font-weight:400;margin-top:4px;">设备网段: ' + escapeHtml(deviceNetwork) + '/' + cidr + ' | LIS网段: ' + escapeHtml(lisNetwork) + '/' + cidr + '</div></div></div>';
    } else {
        html += '<div class="diff-subnet"><i class="fas fa-exclamation-triangle" style="font-size:1.5rem;"></i><div><div>设备与LIS服务器不在同一网段，需要添加路由规则</div><div style="font-size:0.85rem;font-weight:400;margin-top:4px;">设备网段: ' + escapeHtml(deviceNetwork) + '/' + cidr + ' | LIS网段: ' + escapeHtml(lisNetwork) + '/' + cidr + '</div></div></div>';

        const targetNetwork = getNetworkAddress(lisIp, subnetMask);
        const rawCmd = 'sudo nmcli con mod ' + iface + ' +ipv4.routes "' + targetNetwork + '/' + cidr + ' ' + gateway + '"';

        html += '<div class="result-box">';
        html += '<button class="btn-copy copy-btn" onclick="copyCmd(this)"><i class="fas fa-copy me-1"></i>复制</button>';
        html += '<div style="margin-bottom:8px;color:#94a3b8;font-size:0.82rem;">请在设备后台执行以下命令：</div>';
        html += '<div id="generatedCmd">' + escapeHtml(rawCmd) + '</div>';
        html += '</div>';

        addRouteRule(rawCmd, deviceIp, lisIp, gateway);
    }

    document.getElementById('routeResult').innerHTML = html;
}

function copyCmd(btn) {
    const cmd = btn.parentElement.querySelector('#generatedCmd, .cmd-text').textContent;
    navigator.clipboard.writeText(cmd).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check me-1"></i>已复制';
        setTimeout(() => { btn.innerHTML = orig; }, 1500);
    }).catch(() => {
        const ta = document.createElement('textarea');
        ta.value = cmd;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check me-1"></i>已复制';
        setTimeout(() => { btn.innerHTML = orig; }, 1500);
    });
}

function copyRouteCmd(btn) {
    const item = btn.closest('.route-rule-item');
    const cmd = item.querySelector('.cmd-text').textContent;
    navigator.clipboard.writeText(cmd).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check me-1"></i>已复制';
        setTimeout(() => { btn.innerHTML = orig; }, 1500);
    }).catch(() => {
        const ta = document.createElement('textarea');
        ta.value = cmd;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check me-1"></i>已复制';
        setTimeout(() => { btn.innerHTML = orig; }, 1500);
    });
}

function addRouteRuleFromResult() {
    const r = window._pendingRoute;
    if (!r) return;
    addRouteRule(r.cmd, r.deviceIp, r.lisIp, r.gateway);
}

function addRouteRule(cmd, deviceIp, lisIp, gateway) {
    const ts = new Date().toLocaleString('zh-CN');
    routeRules.push({ cmd, deviceIp, lisIp, gateway, time: ts });
    renderRouteRules();
}

function removeRouteRule(idx) {
    routeRules.splice(idx, 1);
    renderRouteRules();
}

function renderRouteRules() {
    const container = document.getElementById('routeRulesList');
    if (routeRules.length === 0) {
        container.innerHTML = '<div class="empty-state" style="padding:30px;"><i class="fas fa-route" style="font-size:2.5rem;"></i><div class="mt-2" style="font-size:0.95rem;">暂无路由规则，请先生成并添加</div></div>';
        return;
    }
    let html = '';
    routeRules.forEach((r, i) => {
        html += '<div class="route-rule-item">';
        html += '<div style="flex:1;">';
        html += '<div class="cmd-text">' + escapeHtml(r.cmd) + '</div>';
        html += '<div class="rule-meta">设备: ' + escapeHtml(r.deviceIp) + ' | LIS: ' + escapeHtml(r.lisIp) + ' | 网关: ' + escapeHtml(r.gateway) + ' | ' + escapeHtml(r.time) + '</div>';
        html += '</div>';
        html += '<button class="btn-copy" onclick="copyRouteCmd(this)" style="margin-right:8px;"><i class="fas fa-copy me-1"></i></button>';
        html += '<button class="del-btn" onclick="removeRouteRule(' + i + ')"><i class="fas fa-trash"></i></button>';
        html += '</div>';
    });
    container.innerHTML = html;
}

// === LIS日志上传功能 ===
let hasTemplate = false;
let currentTemplateId = null;
let currentTemplateHasPdf = false;

async function loadLogModels() {
    const series = document.getElementById('logSeriesFilter').value;
    const modelSel = document.getElementById('logModelFilter');
    modelSel.innerHTML = '<option value="">选择型号</option>';
    if (!series) return;
    const resp = await fetch('/api/models?series=' + series);
    const models = await resp.json();
    models.forEach(m => { modelSel.innerHTML += '<option value="' + escapeHtml(m.name) + '">' + escapeHtml(m.name) + '</option>'; });
}

document.getElementById('logSeriesFilter').addEventListener('change', () => { loadLogModels(); hasTemplate = false; currentTemplateId = null; updateParseBtn(); resetTemplateUI(); });
document.getElementById('logModelFilter').addEventListener('change', () => { checkTemplate(); updateParseBtn(); });

function updateParseBtn() {
    const model = document.getElementById('logModelFilter').value;
    document.getElementById('parseLogBtn').disabled = !(hasTemplate && selectedLogFile && model);
}

function resetTemplateUI() {
    document.getElementById('templateStatus').style.display = 'none';
    document.getElementById('templateUploadArea').style.display = '';
    hasTemplate = false;
    currentTemplateId = null;
    currentTemplateHasPdf = false;
}

async function checkTemplate() {
    const series = document.getElementById('logSeriesFilter').value;
    const model = document.getElementById('logModelFilter').value;
    if (!series || !model) { resetTemplateUI(); return; }
    try {
        const resp = await fetch('/api/lis/templates/' + series + '/' + model, { credentials: 'include' });
        if (resp.ok) {
            const data = await resp.json();
            currentTemplateId = data.id;
            currentTemplateHasPdf = !!data.pdf_filename;
            document.getElementById('templateFileName').textContent = data.pdf_filename || data.filename || '协议模板';
            document.getElementById('templateUpdateTime').textContent = '更新于 ' + (data.updated_at || '').substring(0, 19);
            document.getElementById('templateStatus').style.display = 'block';
            document.getElementById('templateUploadArea').style.display = 'none';
            document.getElementById('viewPdfBtn').style.display = currentTemplateHasPdf ? '' : 'none';
            hasTemplate = true;
        } else {
            resetTemplateUI();
        }
    } catch (e) {
        resetTemplateUI();
    }
    updateParseBtn();
}

const protocolUploadZone = document.getElementById('protocolUploadZone');
const protocolFileInput = document.getElementById('protocolFileInput');

protocolUploadZone.addEventListener('click', () => protocolFileInput.click());
protocolUploadZone.addEventListener('dragover', e => { e.preventDefault(); protocolUploadZone.classList.add('drag-over'); });
protocolUploadZone.addEventListener('dragleave', () => { protocolUploadZone.classList.remove('drag-over'); });
protocolUploadZone.addEventListener('drop', e => { e.preventDefault(); protocolUploadZone.classList.remove('drag-over'); if (e.dataTransfer.files.length) uploadTemplate(e.dataTransfer.files[0]); });
protocolFileInput.addEventListener('change', () => { if (protocolFileInput.files.length) uploadTemplate(protocolFileInput.files[0]); });

async function uploadTemplate(file) {
    const series = document.getElementById('logSeriesFilter').value;
    const model = document.getElementById('logModelFilter').value;
    if (!series || !model) { showAlert('请先选择系列和型号'); return; }
    const ext = file.name.split('.').pop().toLowerCase();
    if (!['pdf', 'txt', 'log', 'hl7'].includes(ext)) { showAlert('仅支持 PDF / .txt / .log / .hl7 文件'); return; }

    document.getElementById('templateUploadArea').style.display = 'none';
    document.getElementById('protocolUploading').style.display = 'block';

    const formData = new FormData();
    formData.append('file', file);
    formData.append('series', series);
    formData.append('model', model);

    try {
        const resp = await fetch('/api/lis/templates', { method: 'POST', body: formData, credentials: 'include' });
        const data = await resp.json();
        if (data.error) { showAlert(data.error); resetTemplateUI(); return; }
        await checkTemplate();
    } catch (err) {
        showAlert('上传失败: ' + err.message);
        resetTemplateUI();
    } finally {
        document.getElementById('protocolUploading').style.display = 'none';
    }
}

function replaceTemplate() {
    document.getElementById('templateStatus').style.display = 'none';
    document.getElementById('templateUploadArea').style.display = '';
    hasTemplate = false;
    updateParseBtn();
}

async function deleteTemplate() {
    if (!currentTemplateId) return;
    try {
        const resp = await fetch('/api/lis/templates/' + currentTemplateId, { method: 'DELETE', credentials: 'include' });
        const data = await resp.json();
        if (data.error) { showAlert(data.error); return; }
        resetTemplateUI();
    } catch (e) {
        showAlert('删除失败');
    }
}

function viewTemplatePdf() {
    if (!currentTemplateId) return;
    window.open('/api/lis/templates/' + currentTemplateId + '/pdf', '_blank');
}

async function editTemplateContent() {
    if (!currentTemplateId) return;
    try {
        const series = document.getElementById('logSeriesFilter').value;
        const model = document.getElementById('logModelFilter').value;
        const resp = await fetch('/api/lis/templates/' + series + '/' + model, { credentials: 'include' });
        if (!resp.ok) { showAlert('获取模板失败'); return; }
        const data = await resp.json();
        document.getElementById('editTemplateId').value = data.id;
        document.getElementById('editTemplateContent').value = data.content || '';
        document.getElementById('editTemplateModal').style.display = 'flex';
    } catch (e) {
        showAlert('加载模板失败');
    }
}

function closeEditTemplate() {
    document.getElementById('editTemplateModal').style.display = 'none';
}

let lisPasswordResolve = null;

function showLisPasswordModal() {
    document.getElementById('lisSuperPasswordInput').value = '';
    document.getElementById('lisPasswordModal').style.display = 'flex';
    document.getElementById('lisSuperPasswordInput').focus();
    return new Promise(resolve => { lisPasswordResolve = resolve; });
}

function closeLisPasswordModal(password) {
    document.getElementById('lisPasswordModal').style.display = 'none';
    if (lisPasswordResolve) {
        lisPasswordResolve(password);
        lisPasswordResolve = null;
    }
}

async function saveTemplateContent() {
    const password = await showLisPasswordModal();
    if (!password) return;
    try {
        const verifyResp = await fetch('/api/verify_super_admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password: password }),
            credentials: 'include'
        });
        if (!verifyResp.ok) { showAlert('管理员密码错误'); return; }
    } catch (e) { showAlert('验证失败'); return; }

    const tid = document.getElementById('editTemplateId').value;
    const content = document.getElementById('editTemplateContent').value;
    try {
        const resp = await fetch('/api/lis/templates/' + tid + '/content', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ content: content }),
            credentials: 'include'
        });
        const data = await resp.json();
        if (data.error) { showAlert(data.error); return; }
        closeEditTemplate();
        showAlert('模板文本已保存');
    } catch (e) {
        showAlert('保存失败');
    }
}

const logUploadZone = document.getElementById('logUploadZone');
const logFileInput = document.getElementById('logFileInput');

logUploadZone.addEventListener('click', () => logFileInput.click());
logUploadZone.addEventListener('dragover', e => { e.preventDefault(); logUploadZone.classList.add('drag-over'); });
logUploadZone.addEventListener('dragleave', () => { logUploadZone.classList.remove('drag-over'); });
logUploadZone.addEventListener('drop', e => { e.preventDefault(); logUploadZone.classList.remove('drag-over'); if (e.dataTransfer.files.length) handleLogFile(e.dataTransfer.files[0]); });
logFileInput.addEventListener('change', () => { if (logFileInput.files.length) handleLogFile(logFileInput.files[0]); });

function handleLogFile(file) {
    const ext = file.name.split('.').pop().toLowerCase();
    if (!['txt', 'log'].includes(ext)) { showAlert('仅支持 .txt 或 .log 文件'); return; }
    selectedLogFile = file;
    document.getElementById('logFileName').textContent = file.name;
    document.getElementById('logFileSize').textContent = formatFileSize(file.size);
    document.getElementById('logFileInfo').style.display = 'block';
    logUploadZone.style.display = 'none';
    updateParseBtn();
}

function clearLogFile() {
    selectedLogFile = null;
    logFileInput.value = '';
    document.getElementById('logFileInfo').style.display = 'none';
    logUploadZone.style.display = '';
    updateParseBtn();
}

function formatFileSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}

async function parseLogFile() {
    if (!hasTemplate) { showAlert('该型号暂无协议模板，请先上传'); return; }
    if (!selectedLogFile) { showAlert('请先上传日志文件'); return; }
    const series = document.getElementById('logSeriesFilter').value;
    const model = document.getElementById('logModelFilter').value;
    if (!series || !model) { showAlert('请先选择系列和型号'); return; }

    const formData = new FormData();
    formData.append('log', selectedLogFile);
    formData.append('series', series);
    formData.append('model', model);

    document.getElementById('parseLogBtn').disabled = true;
    document.getElementById('parseLogBtn').innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> 比对中...';

    try {
        const resp = await fetch('/api/lis/parse-log', { method: 'POST', body: formData, credentials: 'include' });
        const data = await resp.json();
        if (data.error) { showAlert(data.error); return; }
        renderParseResults(data);
    } catch (err) {
        showAlert('比对失败: ' + err.message);
    } finally {
        document.getElementById('parseLogBtn').disabled = false;
        document.getElementById('parseLogBtn').innerHTML = '<i class="fas fa-search me-1"></i> 开始比对';
    }
}

function renderParseResults(data) {
    if (data.error) { showAlert(data.error); return; }
    if (!data.log_lines) { showAlert('比对结果格式异常'); return; }

    document.getElementById('compareEmptyCard').style.display = 'none';
    document.getElementById('compareResultCard').style.display = '';

    const s = data.summary;
    let summaryHtml = '<div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">';
    summaryHtml += '<span class="stat-badge"><i class="fas fa-file-alt"></i> ' + s.total_lines + ' 行</span>';
    if (s.total_frames !== undefined) {
        summaryHtml += '<span class="stat-badge" style="background:linear-gradient(135deg,#e0e7ff,#c7d2fe);color:#4338ca;"><i class="fas fa-layer-group"></i> ' + s.complete_frames + '/' + s.total_frames + ' 完整帧</span>';
    }
    summaryHtml += '<span class="stat-badge" style="background:linear-gradient(135deg,#fee2e2,#fecaca);color:#991b1b;"><i class="fas fa-times-circle"></i> ' + s.fail_count + ' 异常</span>';
    summaryHtml += '<span class="stat-badge" style="background:linear-gradient(135deg,#fef3c7,#fde68a);color:#92400e;"><i class="fas fa-exclamation-triangle"></i> ' + s.warn_count + ' 警告</span>';
    if (s.info_count) {
        summaryHtml += '<span class="stat-badge" style="background:linear-gradient(135deg,#e0f2fe,#bae6fd);color:#0369a1;"><i class="fas fa-info-circle"></i> ' + s.info_count + ' 提示</span>';
    }
    summaryHtml += '<span style="color:#94a3b8;font-size:0.85rem;">' + escapeHtml(s.filename) + ' | ' + s.series + ' ' + s.model + '</span>';
    summaryHtml += '</div>';
    document.getElementById('compareSummary').innerHTML = summaryHtml;

    let leftHtml = '';
    let rightHtml = '';

    data.log_lines.forEach(item => {
        const ln = item.line;
        const text = item.text;
        const issues = item.issues;
        const hasFail = issues.some(i => i.type === 'fail');
        const hasWarn = issues.some(i => i.type === 'warn');
        const hasInfo = issues.some(i => i.type === 'info');
        const hasIssue = issues.length > 0;

        const lineBg = hasFail ? '#fef2f2' : (hasWarn ? '#fffbeb' : (hasInfo ? '#f0f9ff' : 'transparent'));
        const lineColor = hasFail ? '#dc2626' : (hasWarn ? '#d97706' : (hasInfo ? '#0369a1' : '#334155'));

        leftHtml += '<div style="display:flex;min-height:1.7em;padding:0 12px;background:' + lineBg + ';border-bottom:1px solid #f1f5f9;">';
        leftHtml += '<span style="color:#94a3b8;min-width:40px;text-align:right;padding-right:10px;user-select:none;font-size:0.78rem;">' + ln + '</span>';
        leftHtml += '<span style="color:' + lineColor + ';white-space:pre-wrap;word-break:break-all;">' + escapeHtml(text) + '</span>';
        leftHtml += '</div>';

        rightHtml += '<div style="display:flex;min-height:1.7em;padding:0 12px;background:' + lineBg + ';border-bottom:1px solid #f1f5f9;">';
        rightHtml += '<span style="color:#94a3b8;min-width:40px;text-align:right;padding-right:10px;user-select:none;font-size:0.78rem;">' + ln + '</span>';
        if (hasIssue) {
            rightHtml += '<div style="flex:1;">';
            rightHtml += '<div style="color:' + lineColor + ';white-space:pre-wrap;word-break:break-all;">' + escapeHtml(text) + '</div>';
            issues.forEach(iss => {
                let issColor, issIcon;
                if (iss.type === 'fail') { issColor = '#dc2626'; issIcon = 'fas fa-times-circle'; }
                else if (iss.type === 'warn') { issColor = '#d97706'; issIcon = 'fas fa-exclamation-triangle'; }
                else { issColor = '#0369a1'; issIcon = 'fas fa-info-circle'; }
                rightHtml += '<div style="font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:0.8rem;color:' + issColor + ';padding:2px 0;"><i class="' + issIcon + '" style="margin-right:4px;"></i>' + escapeHtml(iss.msg) + '</div>';
            });
            rightHtml += '</div>';
        } else {
            rightHtml += '<span style="color:#94a3b8;white-space:pre-wrap;word-break:break-all;">' + escapeHtml(text) + '</span>';
        }
        rightHtml += '</div>';
    });

    const leftPanel = document.getElementById('logLeftPanel');
    const rightPanel = document.getElementById('logRightPanel');
    leftPanel.innerHTML = leftHtml;
    rightPanel.innerHTML = rightHtml;

    let syncing = false;
    leftPanel.addEventListener('scroll', () => { if (syncing) return; syncing = true; rightPanel.scrollTop = leftPanel.scrollTop; syncing = false; });
    rightPanel.addEventListener('scroll', () => { if (syncing) return; syncing = true; leftPanel.scrollTop = rightPanel.scrollTop; syncing = false; });
}
</script>
</body>
</html>
'''

# ========== 模板: HARDWARE_FAILURES_HTML (硬件故障案例) ==========
HARDWARE_FAILURES_HTML = '''
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <title>硬件故障案例</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%); padding: 20px; min-height: 100vh; }
        .container { max-width: 1200px; margin: 0 auto; }
        .ivd-card { background: white; border-radius: 16px; padding: 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border: 1px solid #e8ecf1; margin-bottom: 24px; }
        .header-bar { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); border-radius: 16px; padding: 24px 28px; margin-bottom: 24px; color: white; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 20px rgba(239,68,68,0.3); }
        .header-bar h1 { font-size: 1.5rem; font-weight: 700; margin: 0; }
        .header-bar .back-link { color: white; text-decoration: none; font-size: 0.95rem; opacity: 0.9; transition: opacity 0.2s; }
        .header-bar .back-link:hover { opacity: 1; }
        .btn-primary-custom { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; border: none; border-radius: 10px; padding: 10px 20px; font-weight: 600; cursor: pointer; transition: all 0.3s; }
        .btn-primary-custom:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(239,68,68,0.4); color: white; }
        .btn-danger-custom { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; border: none; border-radius: 10px; padding: 8px 16px; font-weight: 600; cursor: pointer; transition: all 0.3s; font-size: 0.85rem; }
        .btn-danger-custom:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(239,68,68,0.4); }
        .btn-sm-custom { padding: 6px 14px; font-size: 0.82rem; border-radius: 8px; border: none; cursor: pointer; font-weight: 600; transition: all 0.2s; }
        .btn-edit { background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; }
        .btn-edit:hover { box-shadow: 0 4px 12px rgba(245,158,11,0.4); }
        .bug-item { background: #f8fafc; border-radius: 14px; padding: 20px; margin-bottom: 16px; border: 1px solid #e8ecf1; transition: all 0.2s; }
        .bug-item:hover { box-shadow: 0 4px 16px rgba(0,0,0,0.08); border-color: #ef4444; }
        .bug-title { font-size: 1.1rem; font-weight: 700; color: #1e293b; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
        .bug-field { margin-bottom: 8px; line-height: 1.6; }
        .bug-field-label { font-weight: 600; color: #475569; min-width: 100px; display: inline-block; }
        .bug-field-value { color: #334155; }
        .bug-meta { display: flex; gap: 16px; margin-top: 12px; padding-top: 12px; border-top: 1px solid #e8ecf1; font-size: 0.85rem; color: #94a3b8; flex-wrap: wrap; align-items: center; }
        .bug-image-thumb { max-width: 120px; max-height: 80px; border-radius: 8px; cursor: pointer; transition: transform 0.2s; border: 2px solid #e8ecf1; }
        .bug-image-thumb:hover { transform: scale(1.1); border-color: #ef4444; }
        .img-delete-wrap { position: relative; display: inline-block; }
        .img-delete-wrap .img-del-btn { position: absolute; top: -6px; right: -6px; width: 22px; height: 22px; background: #ef4444; color: #fff; border: 2px solid #fff; border-radius: 50%; font-size: 0.7rem; cursor: pointer; opacity: 0; visibility: hidden; display: flex; align-items: center; justify-content: center; z-index: 5; box-shadow: 0 2px 6px rgba(0,0,0,0.3); transition: all 0.15s; }
        .img-delete-wrap:hover .img-del-btn { opacity: 1; visibility: visible; }
        .img-delete-wrap .img-del-btn:hover { transform: scale(1.2); background: #dc2626; }
        .img-delete-wrap .bug-image-thumb:hover { transform: none; border-color: #ef4444; }
        #pasteZone.drag-over { border-color: #ef4444; background: #fee2e2; }
        .filter-bar { display: flex; gap: 12px; align-items: center; margin-bottom: 20px; flex-wrap: wrap; }
        .stat-badge { display: inline-flex; align-items: center; gap: 6px; background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%); padding: 8px 16px; border-radius: 20px; font-weight: 600; color: #991b1b; font-size: 0.9rem; }
        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); justify-content: center; align-items: center; z-index: 9999; padding: 20px; backdrop-filter: blur(4px); }
        .modal-card { background: white; border-radius: 20px; width: min(100%, 700px); max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 80px rgba(0,0,0,0.25); }
        .modal-header { padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #f0f4f8; background: linear-gradient(135deg, #f8fafc 0%, #f0f4f8 100%); }
        .modal-title { font-size: 1.2rem; font-weight: 700; color: #dc2626; }
        .modal-close { border: none; background: #f1f5f9; color: #64748b; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; font-size: 1.3rem; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
        .modal-close:hover { background: #e2e8f0; color: #ef4444; }
        .modal-body { padding: 24px; }
        .form-label-custom { font-weight: 600; color: #475569; margin-bottom: 6px; }
        .form-control-custom { border-radius: 10px; border: 2px solid #e8ecf1; padding: 10px 14px; transition: border-color 0.2s; }
        .form-control-custom:focus { border-color: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,0.1); }
        .empty-state { text-align: center; padding: 60px 20px; color: #94a3b8; }
        .empty-state i { font-size: 4rem; opacity: 0.4; }
        .image-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 10000; justify-content: center; align-items: center; cursor: pointer; }
        .image-overlay img { max-width: 90vw; max-height: 90vh; border-radius: 12px; box-shadow: 0 0 40px rgba(0,0,0,0.5); }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 10px; }
        ::-webkit-scrollbar-thumb { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); border-radius: 10px; }
    </style>
</head>
<body>
<div class="container">
    <div class="header-bar">
        <div>
            <h1><i class="fas fa-microchip me-2"></i> 硬件故障案例</h1>
            <div style="font-size:0.9rem;opacity:0.85;margin-top:4px;">硬件故障记录与追踪</div>
        </div>
        <a href="/" class="back-link"><i class="fas fa-arrow-left me-1"></i> 返回主页</a>
    </div>
    <div class="ivd-card">
        <div class="filter-bar">
            <select id="seriesFilter" class="form-select form-control-custom" style="max-width:160px;">
                <option value="">选择系列</option>
                <option value="SMART">SMART</option>
                <option value="VENUS">VENUS</option>
            </select>
            <select id="modelFilter" class="form-select form-control-custom" style="max-width:200px;">
                <option value="">选择型号</option>
            </select>
            <button class="btn-primary-custom" id="queryBtn" onclick="loadFailures(1)" disabled><i class="fas fa-search me-1"></i> 查询全部</button>
            <div class="stat-badge" id="failureCount"><i class="fas fa-microchip"></i> <span>0</span> 条记录</div>
            <div style="flex:1;"></div>
            <button class="btn-primary-custom" id="addBtn" onclick="openAddModal()" disabled><i class="fas fa-plus me-1"></i> 添加故障</button>
        </div>
        <div style="display:flex;gap:10px;margin-bottom:16px;">
            <input type="text" id="searchInput" class="form-control form-control-custom" placeholder="搜索故障（现象、原因、方案）..." style="flex:1;">
            <button class="btn-primary-custom" onclick="doSearch(1)"><i class="fas fa-search me-1"></i> 搜索</button>
        </div>
        <div id="failureList">
            <div class="empty-state"><i class="fas fa-hand-pointer"></i><div class="mt-3">请先选择系列和型号</div></div>
        </div>
        <div id="pagination" style="margin-top:16px;display:flex;justify-content:center;gap:8px;flex-wrap:wrap;"></div>
    </div>
</div>
<div class="modal-overlay" id="failureModal">
    <div class="modal-card">
        <div class="modal-header">
            <div class="modal-title" id="modalTitle">添加故障</div>
            <button class="modal-close" onclick="closeModal()">&times;</button>
        </div>
        <div class="modal-body">
            <form id="failureForm" onsubmit="return false;">
                <input type="hidden" id="editId" value="">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label-custom">设备型号 *</label>
                        <input type="text" id="failureModelDisplay" class="form-control form-control-custom" readonly style="background:#f1f5f9;color:#475569;font-weight:600;">
                        <input type="hidden" id="failureModel" value="">
                    </div>
                    <div class="col-12">
                        <label class="form-label-custom">故障现象 *</label>
                        <input type="text" id="failurePhenomenon" class="form-control form-control-custom" placeholder="描述故障现象" required>
                    </div>
                    <div class="col-12">
                        <label class="form-label-custom">故障原因</label>
                        <textarea id="failureCause" class="form-control form-control-custom" rows="2" placeholder="分析故障原因"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label-custom">临时方案</label>
                        <textarea id="failureWorkaround" class="form-control form-control-custom" rows="2" placeholder="临时解决方案"></textarea>
                    </div>
                     <div class="col-12">
                         <label class="form-label-custom">排查过程</label>
                         <textarea id="failureProcess" class="form-control form-control-custom" rows="3" placeholder="详细记录排查过程"></textarea>
                     </div>
                     <div class="col-12">
                         <label class="form-label-custom">排查建议</label>
                         <textarea id="failureSuggestion" class="form-control form-control-custom" rows="2" placeholder="排查建议和注意事项"></textarea>
                     </div>
                     <div class="col-12">
                         <label class="form-label-custom">解决方案</label>
                        <textarea id="failureSolution" class="form-control form-control-custom" rows="2" placeholder="最终解决方案"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label-custom">附加截图（可选，支持多张）</label>
                        <div id="pasteZone" style="border:2px dashed #cbd5e1;border-radius:12px;padding:20px;text-align:center;cursor:pointer;transition:all 0.2s;background:#f8fafc;margin-bottom:8px;" onclick="document.getElementById('failureImage').click()">
                            <i class="fas fa-images" style="font-size:2rem;color:#94a3b8;"></i>
                            <div style="margin-top:8px;color:#64748b;font-weight:600;">点击选择图片 或 Ctrl+V 粘贴截图</div>
                            <div style="font-size:0.8rem;color:#94a3b8;margin-top:4px;">支持多选、多次粘贴，JPG/PNG/GIF/WebP</div>
                        </div>
                        <input type="file" id="failureImage" class="form-control form-control-custom" accept="image/jpeg,image/png,image/gif,image/webp" multiple style="display:none;">
                        <div id="imagePreviewArea" style="margin-top:8px;display:flex;flex-wrap:wrap;gap:10px;"></div>
                    </div>
                    <div class="col-12" style="text-align:right;margin-top:8px;">
                        <button type="button" class="btn btn-light" onclick="closeModal()" style="border-radius:10px;margin-right:8px;">取消</button>
                        <button type="button" class="btn-primary-custom" onclick="submitFailure()"><i class="fas fa-save me-1"></i> 保存</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<div class="image-overlay" id="imageOverlay" onclick="this.style.display='none'">
    <img id="overlayImage" src="">
</div>
<div class="modal-overlay" id="confirmModal" style="display:none;">
    <div class="modal-card" style="max-width:420px;">
        <div class="modal-header">
            <div class="modal-title"><i class="fas fa-exclamation-triangle me-2" style="color:#f59e0b;"></i>确认删除</div>
        </div>
        <div class="modal-body">
            <p id="confirmMessage" style="margin:0;font-size:1rem;color:#334155;">确定要删除这条故障记录吗？此操作不可恢复。</p>
        </div>
        <div style="padding:16px 24px;display:flex;justify-content:flex-end;gap:10px;border-top:1px solid #e8ecf1;">
            <button onclick="closeConfirmModal(false)" style="padding:8px 20px;border:1px solid #d1d5db;background:#f3f4f6;color:#374151;border-radius:8px;cursor:pointer;font-weight:600;">取消</button>
            <button onclick="closeConfirmModal(true)" style="padding:8px 20px;border:none;background:linear-gradient(135deg,#ef4444,#dc2626);color:white;border-radius:8px;cursor:pointer;font-weight:600;">确定删除</button>
        </div>
    </div>
</div>
<div class="modal-overlay" id="alertModal" style="display:none;">
    <div class="modal-card" style="max-width:420px;">
        <div class="modal-header">
            <div class="modal-title"><i class="fas fa-info-circle me-2" style="color:#00a8cc;"></i>提示</div>
        </div>
        <div class="modal-body">
            <p id="alertMessage" style="margin:0;font-size:1rem;color:#334155;"></p>
        </div>
        <div style="padding:16px 24px;display:flex;justify-content:center;gap:10px;border-top:1px solid #e8ecf1;">
            <button onclick="closeAlertModal()" style="padding:8px 30px;border:none;background:linear-gradient(135deg,#00a8cc,#0084a8);color:white;border-radius:8px;cursor:pointer;font-weight:600;">确定</button>
        </div>
    </div>
</div>
<script>
let currentModel = '';
let allFailures = [];
let currentPage = 1;
let totalFailures = 0;
let compressedImageBlobs = [];
let existingImages = [];
const initialSeries = '{{ series }}';
const initialModel = '{{ model }}';

function escapeHtml(text) {
    if (!text) return '';
    const d = document.createElement('div');
    d.textContent = text;
    return d.innerHTML;
}

async function loadModels() {
    const series = document.getElementById('seriesFilter').value;
    const modelSel = document.getElementById('modelFilter');
    modelSel.innerHTML = '<option value="">选择型号</option>';
    document.getElementById('failureList').innerHTML = '<div class="empty-state"><i class="fas fa-hand-pointer"></i><div class="mt-3">请选择型号</div></div>';
    document.getElementById('addBtn').disabled = true;
    document.getElementById('queryBtn').disabled = true;
    currentModel = '';
    if (!series) return;
    const resp = await fetch('/api/models?series=' + series);
    const models = await resp.json();
    models.forEach(m => { modelSel.innerHTML += '<option value="' + escapeHtml(m.name) + '">' + escapeHtml(m.name) + '</option>'; });
    if (initialModel && series === initialSeries) {
        modelSel.value = initialModel;
        if (modelSel.value === initialModel) onModelChange();
    }
}

function onModelChange() {
    currentModel = document.getElementById('modelFilter').value;
    document.getElementById('addBtn').disabled = !currentModel;
    document.getElementById('queryBtn').disabled = !currentModel;
    document.getElementById('searchInput').value = '';
    document.getElementById('pagination').style.display = 'none';
    if (currentModel) { 
        document.getElementById('failureList').innerHTML = '<div class="empty-state"><i class="fas fa-hand-pointer"></i><div class="mt-3">点击"查询全部"加载数据</div></div>';
        document.querySelector('#failureCount span').textContent = '0';
    }
    else { 
        document.getElementById('failureList').innerHTML = '<div class="empty-state"><i class="fas fa-hand-pointer"></i><div class="mt-3">请选择型号</div></div>'; 
        document.querySelector('#failureCount span').textContent = '0'; 
    }
}

async function loadFailures(page) {
    if (!currentModel) return;
    page = page || 1;
    currentPage = page;
    let url = '/api/hardware-failures?model=' + encodeURIComponent(currentModel) + '&page=' + page + '&per_page=20';
    const resp = await fetch(url);
    const data = await resp.json();
    allFailures = data.results;
    totalFailures = data.total;
    document.querySelector('#failureCount span').textContent = data.total;
    renderFailures(allFailures);
    renderPagination(data.total, data.page, data.per_page);
}

function renderFailures(failures) {
    const container = document.getElementById('failureList');
    if (!currentModel) { container.innerHTML = '<div class="empty-state"><i class="fas fa-hand-pointer"></i><div class="mt-3">请先选择系列和型号</div></div>'; return; }
    if (!failures.length) { container.innerHTML = '<div class="empty-state"><i class="fas fa-inbox"></i><div class="mt-3">暂无故障记录</div><div style="font-size:0.9rem;margin-top:5px;">点击上方"添加故障"开始录入</div></div>'; return; }
    let html = '';
    failures.forEach(f => {
        html += '<div class="bug-item">';
        html += '<div class="bug-title"><i class="fas fa-exclamation-triangle" style="color:#ef4444;"></i> ' + escapeHtml(f.phenomenon) + '</div>';
        if (f.cause) html += '<div class="bug-field"><span class="bug-field-label"><i class="fas fa-search me-1"></i>故障原因:</span> <span class="bug-field-value">' + escapeHtml(f.cause) + '</span></div>';
        if (f.workaround) html += '<div class="bug-field"><span class="bug-field-label"><i class="fas fa-shield-alt me-1"></i>临时方案:</span> <span class="bug-field-value">' + escapeHtml(f.workaround) + '</span></div>';
        if (f.process) html += '<div class="bug-field"><span class="bug-field-label"><i class="fas fa-tasks me-1"></i>排查过程:</span> <span class="bug-field-value">' + escapeHtml(f.process) + '</span></div>';
        if (f.suggestion) html += '<div class="bug-field"><span class="bug-field-label"><i class="fas fa-lightbulb me-1" style="color:#f59e0b;"></i>排查建议:</span> <span class="bug-field-value">' + escapeHtml(f.suggestion) + '</span></div>';
        if (f.solution) html += '<div class="bug-field"><span class="bug-field-label"><i class="fas fa-check-circle me-1" style="color:#10b981;"></i>解决方案:</span> <span class="bug-field-value">' + escapeHtml(f.solution) + '</span></div>';
        if (f.image_count > 0) html += '<div class="bug-field" id="failure-images-' + f.id + '"><i class="fas fa-images me-1" style="color:#6366f1;"></i> 加载图片中...</div>';
        html += '<div class="bug-meta">';
        html += '<span><i class="fas fa-clock me-1"></i>' + (f.created_at || '') + '</span>';
        html += '<div style="flex:1;"></div>';
        html += '<button class="btn-sm-custom btn-edit" onclick="editFailure(' + f.id + ')"><i class="fas fa-pen me-1"></i>编辑</button>';
        html += '<button class="btn-danger-custom" style="margin-left:6px;" onclick="deleteFailure(' + f.id + ')"><i class="fas fa-trash me-1"></i>删除</button>';
        html += '</div></div>';
    });
    container.innerHTML = html;
    failures.forEach(f => {
        if (f.image_count > 0) {
            loadFailureImages(f.id);
        }
    });
}

async function loadFailureImages(failureId) {
    try {
        const resp = await fetch('/api/hardware-failures/' + encodeURIComponent(currentModel) + '/' + failureId + '/images');
        const images = await resp.json();
        const container = document.getElementById('failure-images-' + failureId);
        if (!container) return;
        if (images.length === 0) {
            container.innerHTML = '';
            return;
        }
        let html = '<i class="fas fa-images me-1" style="color:#6366f1;"></i> ';
        images.forEach((img, idx) => {
            html += '<img src="/api/hardware-failures/' + encodeURIComponent(currentModel) + '/' + failureId + '/images/' + img.id + '" style="max-width:80px;max-height:60px;border-radius:6px;border:2px solid #e8ecf1;margin-right:6px;cursor:pointer;" onclick="showImage(this.src)" alt="故障图片">';
        });
        container.innerHTML = html;
    } catch (err) {
        console.error('加载故障图片失败:', err);
    }
}

function showImage(src) {
    document.getElementById('overlayImage').src = src;
    document.getElementById('imageOverlay').style.display = 'flex';
}

function openAddModal() {
    if (!currentModel) { alert('请先选择型号'); return; }
    document.getElementById('modalTitle').textContent = '添加故障 - ' + currentModel;
    document.getElementById('editId').value = '';
    document.getElementById('failureModel').value = currentModel;
    document.getElementById('failureModelDisplay').value = currentModel;
    document.getElementById('failurePhenomenon').value = '';
    document.getElementById('failureCause').value = '';
    document.getElementById('failureWorkaround').value = '';
     document.getElementById('failureProcess').value = '';
     document.getElementById('failureSuggestion').value = '';
     document.getElementById('failureSolution').value = '';
    document.getElementById('failureImage').value = '';
    compressedImageBlobs = [];
    existingImages = [];
    document.getElementById('imagePreviewArea').innerHTML = '';
    document.getElementById('failureModal').style.display = 'flex';
}

async function editFailure(id) {
    const f = allFailures.find(item => item.id === id);
    if (!f) return;
    document.getElementById('modalTitle').textContent = '编辑故障 - ' + currentModel;
    document.getElementById('editId').value = id;
    document.getElementById('failureModel').value = currentModel;
    document.getElementById('failureModelDisplay').value = currentModel;
    document.getElementById('failurePhenomenon').value = f.phenomenon;
    document.getElementById('failureCause').value = f.cause || '';
     document.getElementById('failureWorkaround').value = f.workaround || '';
     document.getElementById('failureProcess').value = f.process || '';
     document.getElementById('failureSuggestion').value = f.suggestion || '';
     document.getElementById('failureSolution').value = f.solution || '';
    document.getElementById('failureImage').value = '';
    compressedImageBlobs = [];
    existingImages = [];
    document.getElementById('imagePreviewArea').innerHTML = '';
    if (f.image_count > 0) {
        try {
            const resp = await fetch('/api/hardware-failures/' + encodeURIComponent(currentModel) + '/' + id + '/images');
            existingImages = await resp.json();
            refreshImagePreviews();
        } catch (err) { console.error('加载图片失败:', err); }
    }
    document.getElementById('failureModal').style.display = 'flex';
}

function closeModal() {
    document.getElementById('failureModal').style.display = 'none';
}

function refreshImagePreviews() {
    const area = document.getElementById('imagePreviewArea');
    area.innerHTML = '';
    existingImages.forEach(img => {
        const div = document.createElement('div');
        div.className = 'img-delete-wrap';
        div.style.cssText = 'display:inline-block;position:relative;';
        const imgEl = document.createElement('img');
        imgEl.src = '/api/hardware-failures/' + encodeURIComponent(currentModel) + '/' + document.getElementById('editId').value + '/images/' + img.id;
        imgEl.style.cssText = 'max-width:120px;max-height:80px;border-radius:8px;border:2px solid #e8ecf1;display:block;';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'img-del-btn';
        btn.innerHTML = '<i class="fas fa-times"></i>';
        btn.onclick = function() { deleteImageFromEdit(img.id); };
        div.appendChild(imgEl);
        div.appendChild(btn);
        area.appendChild(div);
    });
    compressedImageBlobs.forEach((blob, idx) => {
        const url = URL.createObjectURL(blob);
        const div = document.createElement('div');
        div.className = 'img-delete-wrap';
        div.style.cssText = 'display:inline-block;position:relative;';
        const imgEl = document.createElement('img');
        imgEl.src = url;
        imgEl.style.cssText = 'max-width:120px;max-height:80px;border-radius:8px;border:2px solid #e8ecf1;display:block;';
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'img-del-btn';
        btn.innerHTML = '<i class="fas fa-times"></i>';
        btn.onclick = function() { removeImage(idx); };
        div.appendChild(imgEl);
        div.appendChild(btn);
        area.appendChild(div);
    });
}

function removeImage(idx) {
    compressedImageBlobs.splice(idx, 1);
    refreshImagePreviews();
}

async function deleteImageFromEdit(imageId) {
    if (!confirm('确定删除此图片？')) return;
    const editId = document.getElementById('editId').value;
    try {
        const resp = await fetch('/api/hardware-failures/' + encodeURIComponent(currentModel) + '/' + editId + '/images/' + imageId, { method: 'DELETE' });
        if (resp.ok) {
            existingImages = existingImages.filter(img => img.id !== imageId);
            refreshImagePreviews();
        } else {
            const d = await resp.json();
            alert(d.error || '删除失败');
        }
    } catch (err) {
        alert('删除失败: ' + err.message);
    }
}

async function submitFailure() {
    const editId = document.getElementById('editId').value;
    const model = document.getElementById('failureModel').value;
    const phenomenon = document.getElementById('failurePhenomenon').value.trim();
     const cause = document.getElementById('failureCause').value.trim();
     const workaround = document.getElementById('failureWorkaround').value.trim();
     const process = document.getElementById('failureProcess').value.trim();
     const suggestion = document.getElementById('failureSuggestion').value.trim();
     const solution = document.getElementById('failureSolution').value.trim();
    
    if (!phenomenon) {
        alert('故障现象为必填项');
        return;
    }
    
    const formData = new FormData();
    formData.append('model', model);
    formData.append('phenomenon', phenomenon);
    formData.append('cause', cause);
    formData.append('workaround', workaround);
    formData.append('process', process);
    formData.append('suggestion', suggestion);
    formData.append('solution', solution);
    
    compressedImageBlobs.forEach((blob, idx) => {
        formData.append('images', blob, 'image_' + idx + '.jpg');
    });
    
    try {
        let resp;
        if (editId) {
            resp = await fetch('/api/hardware-failures/' + encodeURIComponent(model) + '/' + editId, {
                method: 'PUT',
                body: formData,
                credentials: 'include'
            });
        } else {
            resp = await fetch('/api/hardware-failures', {
                method: 'POST',
                body: formData,
                credentials: 'include'
            });
        }
        
        if (resp.status === 401) {
            showAlert('请先登录管理员账号，即将跳转登录页面...');
            setTimeout(() => { window.location.href = '/admin/login'; }, 2000);
            return;
        }
        
        const data = await resp.json();
        if (resp.ok) {
            closeModal();
            loadFailures(currentPage);
        } else {
            showAlert(data.error || '操作失败');
        }
    } catch (err) {
        showAlert('操作失败: ' + err.message);
    }
}

let confirmResolve = null;

async function showConfirm(message) {
    document.getElementById('confirmMessage').textContent = message;
    document.getElementById('confirmModal').style.display = 'flex';
    return new Promise(resolve => { confirmResolve = resolve; });
}

function closeConfirmModal(result) {
    document.getElementById('confirmModal').style.display = 'none';
    if (confirmResolve) {
        confirmResolve(result);
        confirmResolve = null;
    }
}

function showAlert(message) {
    document.getElementById('alertMessage').textContent = message;
    document.getElementById('alertModal').style.display = 'flex';
}

function closeAlertModal() {
    document.getElementById('alertModal').style.display = 'none';
}

let passwordResolve = null;

async function showPasswordModal() {
    document.getElementById('superPasswordInput').value = '';
    document.getElementById('passwordModal').style.display = 'flex';
    document.getElementById('superPasswordInput').focus();
    return new Promise(resolve => { passwordResolve = resolve; });
}

function closePasswordModal(password) {
    document.getElementById('passwordModal').style.display = 'none';
    if (passwordResolve) {
        passwordResolve(password);
        passwordResolve = null;
    }
}

async function deleteFailure(id) {
    if (!await showConfirm('确定要删除这条故障记录吗？此操作不可恢复。')) return;
    try {
        const resp = await fetch('/api/hardware-failures/' + encodeURIComponent(currentModel) + '/' + id, { 
            method: 'DELETE',
            credentials: 'include'
        });
        if (resp.status === 401) {
            showAlert('请先登录管理员账号');
            return;
        }
        if (resp.ok) {
            loadFailures(currentPage);
        } else {
            const d = await resp.json();
            showAlert(d.error || '删除失败');
        }
    } catch (err) {
        showAlert('删除失败: ' + err.message);
    }
}

function renderPagination(total, currentPage, perPage) {
    const container = document.getElementById('pagination');
    const totalPages = Math.ceil(total / perPage);
    if (totalPages <= 1) { container.style.display = 'none'; return; }
    container.style.display = 'flex';
    let html = '';
    if (currentPage > 1) html += '<button class="btn-sm-custom" style="background:#e2e8f0;color:#475569;" onclick="loadFailures(' + (currentPage-1) + ')"><i class="fas fa-chevron-left"></i></button>';
    let start = Math.max(1, currentPage - 2);
    let end = Math.min(totalPages, start + 4);
    if (end - start < 4) start = Math.max(1, end - 4);
    for (let i = start; i <= end; i++) {
        if (i === currentPage) html += '<button class="btn-sm-custom" style="background:linear-gradient(135deg,#ef4444,#dc2626);color:white;">' + i + '</button>';
        else html += '<button class="btn-sm-custom" style="background:#e2e8f0;color:#475569;" onclick="loadFailures(' + i + ')">' + i + '</button>';
    }
    if (currentPage < totalPages) html += '<button class="btn-sm-custom" style="background:#e2e8f0;color:#475569;" onclick="loadFailures(' + (currentPage+1) + ')"><i class="fas fa-chevron-right"></i></button>';
    html += '<span style="font-size:0.85rem;color:#94a3b8;margin-left:8px;">共 ' + total + ' 条</span>';
    container.innerHTML = html;
}

async function doSearch(page) {
    const q = document.getElementById('searchInput').value.trim();
    if (!q) { if (currentModel) loadFailures(); else { document.getElementById('failureList').innerHTML = '<div class="empty-state"><i class="fas fa-hand-pointer"></i><div class="mt-3">请先选择系列和型号</div></div>'; document.getElementById('pagination').style.display = 'none'; } return; }
    const model = currentModel;
    let url = '/api/hardware-failures/search?q=' + encodeURIComponent(q) + '&page=' + page;
    if (model) url += '&model=' + encodeURIComponent(model);
    const resp = await fetch(url);
    const data = await resp.json();
    document.querySelector('#failureCount span').textContent = data.total;
    renderFailures(data.results);
    renderPagination(data.total, data.page, data.per_page);
}

// 图片上传处理
document.getElementById('failureImage').onchange = function(e) {
    const files = Array.from(e.target.files);
    files.forEach(file => {
        if (!file.type.startsWith('image/')) return;
        compressImage(file);
    });
};

document.getElementById('pasteZone').onpaste = function(e) {
    const items = e.clipboardData.items;
    for (let i = 0; i < items.length; i++) {
        if (items[i].type.startsWith('image/')) {
            const file = items[i].getAsFile();
            compressImage(file);
        }
    }
};

document.getElementById('pasteZone').ondragover = function(e) {
    e.preventDefault();
    this.classList.add('drag-over');
};

document.getElementById('pasteZone').ondragleave = function(e) {
    this.classList.remove('drag-over');
};

document.getElementById('pasteZone').ondrop = function(e) {
    e.preventDefault();
    this.classList.remove('drag-over');
    const files = Array.from(e.dataTransfer.files);
    files.forEach(file => {
        if (!file.type.startsWith('image/')) return;
        compressImage(file);
    });
};

async function compressImage(file) {
    const maxSize = 800 * 1024;
    if (file.size <= maxSize) {
        compressedImageBlobs.push(file);
        refreshImagePreviews();
        return;
    }
    
    const img = new Image();
    img.src = URL.createObjectURL(file);
    img.onload = function() {
        const canvas = document.createElement('canvas');
        let width = img.width;
        let height = img.height;
        
        if (width > height && width > 1200) {
            height = Math.round(height * 1200 / width);
            width = 1200;
        } else if (height > 1200) {
            width = Math.round(width * 1200 / height);
            height = 1200;
        }
        
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(img, 0, 0, width, height);
        
        canvas.toBlob(function(blob) {
            compressedImageBlobs.push(blob);
            refreshImagePreviews();
        }, 'image/jpeg', 0.8);
    };
}

document.getElementById('seriesFilter').onchange = loadModels;
document.getElementById('modelFilter').onchange = onModelChange;
document.getElementById('failureModal').onclick = function(e) { if (e.target === this) closeModal(); };
document.getElementById('searchInput').onkeydown = function(e) { if (e.key === 'Enter') doSearch(1); };

if (initialSeries) {
    document.getElementById('seriesFilter').value = initialSeries;
    loadModels();
}
</script>
</body>
</html>
'''

# ========== 模板: BOARD_COMPATIBILITY_HTML (电路板兼容) ==========
BOARD_COMPATIBILITY_HTML = '''
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <title>电路板兼容</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: linear-gradient(135deg, #f5f7fa 0%, #e8ecf1 100%); padding: 20px; min-height: 100vh; }
        .container { max-width: 1200px; margin: 0 auto; }
        .ivd-card { background: white; border-radius: 16px; padding: 28px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border: 1px solid #e8ecf1; margin-bottom: 24px; }
        .header-bar { background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); border-radius: 16px; padding: 24px 28px; margin-bottom: 24px; color: white; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 20px rgba(99,102,241,0.3); }
        .header-bar h1 { font-size: 1.5rem; font-weight: 700; margin: 0; }
        .header-bar .back-link { color: white; text-decoration: none; font-size: 0.95rem; opacity: 0.9; transition: opacity 0.2s; }
        .header-bar .back-link:hover { opacity: 1; }
