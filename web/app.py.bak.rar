            <i class="fas fa-puzzle-piece"></i>
            <div class="mt-3">功能开发中，敬请期待...</div>
            <div style="font-size:0.85rem;margin-top:8px;">系列: {{ series }} | 型号: {{ model if model else '未选择' }}</div>
        </div>
