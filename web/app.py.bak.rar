        .file-node {
            padding: 8px 16px 8px 36px; 
            cursor: pointer; 
            display: flex;
            align-items: center;
            gap: 10px; 
            font-size: 0.78rem; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
