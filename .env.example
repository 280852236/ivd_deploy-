# IVD故障分析平台环境变量示例

# 数据库配置
DB_HOST=postgres
DB_PORT=5432
DB_USER=ivd_user
DB_PASSWORD=ivd_pass
DB_NAME=ivd_fault_db

# Redis配置
REDIS_URL=redis://redis:6379/0

# Go解析器配置
GO_PARSER_URL=http://go-parser:8082/parse

# Flask配置
SECRET_KEY=your-secret-key-here
ADMIN_PASSWORD=admin123
DEBUG=False

# 分析配置
ANALYSIS_TTL_HOURS=2

# 服务端口
WEB_PORT=8081
GO_PARSER_PORT=8082
