# IVD智能故障分析平台 - 环境变量示例
# 实际部署时由 deploy.sh 自动生成 .env 文件

# 数据库
DB_HOST=postgres
DB_PORT=5432
DB_USER=ivd_user
DB_PASSWORD=change-me-to-random
DB_NAME=ivd_fault_db

# Redis
REDIS_URL=redis://redis:6379/0

# Go解析器
GO_PARSER_URL=http://go-parser:8082/parse

# Flask应用
SECRET_KEY=change-me-to-random
ADMIN_PASSWORD=admin123
SUPER_ADMIN_PASSWORD=super2026

# 分析配置
ANALYSIS_TTL_HOURS=2
MAX_CONTENT_LENGTH=209715200
UPLOAD_DIR=/app/uploads

# Grafana
GRAFANA_ADMIN_PASSWORD=change-me-to-random

# 日志级别
LOG_LEVEL=INFO
